<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Toast — icon morph + mensaje</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Urbanist:wght@500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --ui-graphite: #414141;
      --ui-paper: #f8f8f8;

      --outer-size: 72px;
      --inner-size: 56px;

      --expanded-width: 424px;
      --travel: 352px;
      --cycle: 6200ms;
    }

    * { box-sizing: border-box; }

    html,
    body,
    .toast-message {
      font-family: "Urbanist", sans-serif;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding-right: 0;
      background: #ececec;
      overflow-x: hidden;
    }

    .toast-stack {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 18px;
      margin-right: 24px;
    }

    .toast-stage {
      --toast-color: #22c55e;
      --icon-color: #ffffff;
      --outer-bg: var(--ui-paper);

      position: relative;
      width: var(--expanded-width);
      height: var(--outer-size);
    }

    .toast-shell {
      position: absolute;
      inset: 0;
      opacity: 0;
      will-change: opacity;
      animation: shell-visibility var(--cycle) linear 1 forwards;
    }

    .toast-shell__body {
      position: absolute;
      top: 0;
      right: calc(var(--outer-size) / 2);
      width: var(--travel);
      height: var(--outer-size);
      background: var(--outer-bg);
      transform-origin: right center;
      transform: scaleX(0);
      will-change: transform;
      backface-visibility: hidden;
      animation: shell-body var(--cycle) cubic-bezier(.22, .78, .28, 1) 1 forwards;
    }

    .toast-shell__cap {
      position: absolute;
      top: 0;
      right: 0;
      width: var(--outer-size);
      height: var(--outer-size);
      border-radius: 50%;
      background: var(--outer-bg);
      will-change: transform;
      backface-visibility: hidden;
    }

    .toast-shell__cap--right {
      transform: translate3d(0, 0, 0) scale(.72);
      transform-origin: center;
      animation: right-cap-scale var(--cycle) linear 1 forwards;
    }

    .toast-shell__cap--left {
      transform: translate3d(0, 0, 0);
      animation: shell-cap-left var(--cycle) cubic-bezier(.22, .78, .28, 1) 1 forwards;
    }

    .toast-translate {
      position: absolute;
      z-index: 3;
      top: 50%;
      right: calc((var(--outer-size) - var(--inner-size)) / 2);
      width: var(--inner-size);
      height: var(--inner-size);
      transform: translate3d(0, -50%, 0) translateX(0);
      will-change: transform;
      backface-visibility: hidden;
      animation: roller-translate var(--cycle) cubic-bezier(.22, .78, .28, 1) 1 forwards;
    }

    .toast-rotate {
      position: absolute;
      inset: 0;
      transform: rotate(0deg);
      transform-origin: 50% 50%;
      will-change: transform;
      backface-visibility: hidden;
      animation: roller-rotate var(--cycle) cubic-bezier(.22, .78, .28, 1) 1 forwards;
    }

    .toast-mass {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--toast-color);
      transform: scale(.72);
      transform-origin: center;
      will-change: transform;
      backface-visibility: hidden;
      animation: mass-cycle var(--cycle) linear 1 forwards;
    }

    .toast-icon-layer {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      pointer-events: none;
    }

    .toast-icon {
      position: absolute;
      width: 26px;
      height: 26px;
      color: var(--icon-color);
      stroke-width: 2.5;
      stroke-linecap: round;
      stroke-linejoin: round;
      will-change: transform, opacity;
      backface-visibility: hidden;
    }

    .toast-icon--face {
      opacity: 0;
      transform: scale(.62);
      animation: face-icon-cycle var(--cycle) linear 1 forwards;
    }

    .toast-icon--target {
      opacity: 0;
      transform: scale(.55) rotate(24deg);
      animation: target-icon-cycle var(--cycle) linear 1 forwards;
    }

    .toast-message {
      position: absolute;
      z-index: 2;
      top: 50%;
      left: 88px;
      right: 54px;
      min-width: 0;

      color: var(--message-color);
      font-size: 16px;
      line-height: 1.15;
      font-weight: 650;
      letter-spacing: -0.015em;

      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;

      /*
        El texto SIEMPRE existe.
        Sólo cambiamos su ventana visible.
        La región nace en el borde derecho y crece hacia la izquierda,
        justo detrás de la bola mientras rueda.
      */
      opacity: 1;
      transform: translate3d(0, -50%, 0);
      clip-path: inset(0 0 0 100%);
      -webkit-clip-path: inset(0 0 0 100%);

      will-change: clip-path;
      pointer-events: none;

      animation:
        message-print-cycle
        var(--cycle)
        linear
        1 forwards;
    }

    .toast--success {
      --toast-color: #22c55e;
      --icon-color: #ffffff;
      --outer-bg: var(--ui-paper);
      --message-color: var(--ui-graphite);
    }

    .toast--info {
      --toast-color: #ffffff;
      --icon-color: var(--ui-graphite);
      --outer-bg: var(--ui-graphite);
      --message-color: var(--ui-paper);
    }

    .toast--warning {
      --toast-color: #facc15;
      --icon-color: #ffffff;
      --outer-bg: var(--ui-paper);
      --message-color: var(--ui-graphite);
    }

    .toast--error {
      --toast-color: #ef4444;
      --icon-color: #ffffff;
      --outer-bg: var(--ui-paper);
      --message-color: var(--ui-graphite);
    }

    .toast--neutral {
      --toast-color: var(--ui-graphite);
      --icon-color: var(--ui-paper);
      --outer-bg: var(--ui-paper);
      --message-color: var(--ui-graphite);
    }

    @keyframes shell-visibility {
      0% {
        opacity: 0;
        animation-timing-function: cubic-bezier(.16, 1, .3, 1);
      }

      8.4%,
      94.8% {
        opacity: 1;
      }

      94.8% {
        animation-timing-function: cubic-bezier(.7, 0, .84, 0);
      }

      100% {
        opacity: 0;
      }
    }

    @keyframes right-cap-scale {
      0% {
        transform: translate3d(0, 0, 0) scale(.72);
        animation-timing-function: cubic-bezier(.16, 1, .3, 1);
      }

      9%,
      94.8% {
        transform: translate3d(0, 0, 0) scale(1);
      }

      94.8% {
        animation-timing-function: cubic-bezier(.7, 0, .84, 0);
      }

      100% {
        transform: translate3d(0, 0, 0) scale(.76);
      }
    }

    @keyframes shell-body {
      0%, 18% { transform: scaleX(0); }
      48%, 72% { transform: scaleX(1); }
      78%, 100% { transform: scaleX(0); }
    }

    @keyframes shell-cap-left {
      0%, 18% { transform: translate3d(0, 0, 0); }
      48%, 72% { transform: translate3d(calc(var(--travel) * -1), 0, 0); }
      78%, 100% { transform: translate3d(0, 0, 0); }
    }

    @keyframes roller-translate {
      0%, 18% {
        transform: translate3d(0, -50%, 0) translateX(0);
      }

      48%, 72% {
        transform: translate3d(0, -50%, 0) translateX(calc(var(--travel) * -1));
      }

      78%, 100% {
        transform: translate3d(0, -50%, 0) translateX(0);
      }
    }

    @keyframes roller-rotate {
      0%, 18% { transform: rotate(0deg); }
      48%, 72% { transform: rotate(-720deg); }
      78%, 100% { transform: rotate(0deg); }
    }

    @keyframes mass-cycle {
      0% {
        transform: scale(.72);
        animation-timing-function: cubic-bezier(.16, 1, .3, 1);
      }

      9%,
      94.8% {
        transform: scale(1);
      }

      94.8% {
        animation-timing-function: cubic-bezier(.7, 0, .84, 0);
      }

      100% {
        transform: scale(.76);
      }
    }

    /*
      Morph adelantado:
      ocurre bastante antes del final del rodado.
      La face empieza a retirarse alrededor del 27%;
      el icono contextual ya está consolidado hacia el 35%.
    */
    /*
      Todos los eventos usan la MISMA línea temporal del rodado:
      18% -> 48%  : abre / rueda hacia la izquierda
      48% -> 68%  : estado estable
      68% -> 94.8%: cierra / rueda hacia la derecha
    */

    /*
      Línea temporal común:
      18% -> 48%   rodado de ida
      48% -> 68%   reposo
      68% -> 94.8% rodado de vuelta
    */

    @keyframes face-icon-cycle {
      0%,
      2.4% {
        opacity: 0;
        transform: scale(.62);
        animation-timing-function: cubic-bezier(.16, 1, .3, 1);
      }

      6.8% {
        opacity: 1;
        transform: scale(1.08);
      }

      9.5%,
      30% {
        opacity: 1;
        transform: scale(1);
      }

      /* Morph de ida durante el rodado. */
      36%,
      72% {
        opacity: 0;
        transform: scale(.52) rotate(-24deg);
      }

      74% {
        opacity: 0;
        transform: scale(.52) rotate(-24deg);
        animation-timing-function: cubic-bezier(.55, .02, .45, .98);
      }

      77%,
      94.8% {
        opacity: 1;
        transform: scale(1);
      }

      94.8% {
        animation-timing-function: cubic-bezier(.7, 0, .84, 0);
      }

      100% {
        opacity: 0;
        transform: scale(.72);
      }
    }

    @keyframes target-icon-cycle {
      0%,
      30% {
        opacity: 0;
        transform: scale(.52) rotate(24deg);
      }

      36% {
        opacity: 1;
        transform: scale(1.06) rotate(-4deg);
      }

      40%,
      72% {
        opacity: 1;
        transform: scale(1) rotate(0deg);
      }

      74% {
        opacity: 1;
        transform: scale(1) rotate(0deg);
        animation-timing-function: cubic-bezier(.55, .02, .45, .98);
      }

      77%,
      100% {
        opacity: 0;
        transform: scale(.52) rotate(24deg);
      }
    }

    /*
      Texto y bola comparten exactamente el mismo tramo de retorno.
      En ida: revela desde la derecha hacia la izquierda.
      En vuelta: oculta desde la izquierda hacia la derecha.
    */
    @keyframes message-print-cycle {
      0%,
      18% {
        clip-path: inset(0 0 0 100%);
        -webkit-clip-path: inset(0 0 0 100%);
        animation-timing-function: cubic-bezier(.22, .78, .28, 1);
      }

      48%,
      72% {
        clip-path: inset(0 0 0 0%);
        -webkit-clip-path: inset(0 0 0 0%);
      }

      72% {
        animation-timing-function: cubic-bezier(.7, 0, .84, 0);
      }

      74.2%,
      100% {
        clip-path: inset(0 0 0 100%);
        -webkit-clip-path: inset(0 0 0 100%);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .toast-shell,
      .toast-shell__body,
      .toast-shell__cap,
      .toast-translate,
      .toast-rotate,
      .toast-mass,
      .toast-icon,
      .toast-message {
        animation: none;
      }

      .toast-shell {
        opacity: 1;
      }

      .toast-shell__cap--right {
        transform: translate3d(0, 0, 0) scale(1);
      }

      .toast-shell__body {
        transform: scaleX(1);
      }

      .toast-shell__cap--left {
        transform: translateX(calc(var(--travel) * -1));
      }

      .toast-translate {
        transform: translate3d(0, -50%, 0) translateX(calc(var(--travel) * -1));
      }

      .toast-rotate {
        transform: rotate(-720deg);
      }

      .toast-mass,
      .toast-icon,
      .toast-message {
        opacity: 1;
        transform: none;
      }
    }
  </style>
</head>

<body>
  <div class="toast-stack">

    <div class="toast-stage toast--success">
      <div class="toast-shell">
        <div class="toast-shell__body"></div>
        <div class="toast-shell__cap toast-shell__cap--left"></div>
        <div class="toast-shell__cap toast-shell__cap--right"></div>
      </div>
      <div class="toast-translate">
        <div class="toast-rotate">
          <div class="toast-mass"></div>
          <div class="toast-icon-layer">
            <i class="toast-icon toast-icon--face" data-lucide="smile"></i>
            <i class="toast-icon toast-icon--target" data-lucide="phone"></i>
          </div>
        </div>
      </div>
      <div class="toast-message">Llamada conectada</div>
    </div>

    <div class="toast-stage toast--info">
      <div class="toast-shell">
        <div class="toast-shell__body"></div>
        <div class="toast-shell__cap toast-shell__cap--left"></div>
        <div class="toast-shell__cap toast-shell__cap--right"></div>
      </div>
      <div class="toast-translate">
        <div class="toast-rotate">
          <div class="toast-mass"></div>
          <div class="toast-icon-layer">
            <i class="toast-icon toast-icon--face" data-lucide="laugh"></i>
            <i class="toast-icon toast-icon--target" data-lucide="message-circle"></i>
          </div>
        </div>
      </div>
      <div class="toast-message">Tienes nueva información</div>
    </div>

    <div class="toast-stage toast--warning">
      <div class="toast-shell">
        <div class="toast-shell__body"></div>
        <div class="toast-shell__cap toast-shell__cap--left"></div>
        <div class="toast-shell__cap toast-shell__cap--right"></div>
      </div>
      <div class="toast-translate">
        <div class="toast-rotate">
          <div class="toast-mass"></div>
          <div class="toast-icon-layer">
            <i class="toast-icon toast-icon--face" data-lucide="meh"></i>
            <i class="toast-icon toast-icon--target" data-lucide="triangle-alert"></i>
          </div>
        </div>
      </div>
      <div class="toast-message">Revisa esta advertencia</div>
    </div>

    <div class="toast-stage toast--error">
      <div class="toast-shell">
        <div class="toast-shell__body"></div>
        <div class="toast-shell__cap toast-shell__cap--left"></div>
        <div class="toast-shell__cap toast-shell__cap--right"></div>
      </div>
      <div class="toast-translate">
        <div class="toast-rotate">
          <div class="toast-mass"></div>
          <div class="toast-icon-layer">
            <i class="toast-icon toast-icon--face" data-lucide="frown"></i>
            <i class="toast-icon toast-icon--target" data-lucide="bug"></i>
          </div>
        </div>
      </div>
      <div class="toast-message">Se detectó un error</div>
    </div>

    <div class="toast-stage toast--neutral">
      <div class="toast-shell">
        <div class="toast-shell__body"></div>
        <div class="toast-shell__cap toast-shell__cap--left"></div>
        <div class="toast-shell__cap toast-shell__cap--right"></div>
      </div>
      <div class="toast-translate">
        <div class="toast-rotate">
          <div class="toast-mass"></div>
          <div class="toast-icon-layer">
            <i class="toast-icon toast-icon--face" data-lucide="annoyed"></i>
            <i class="toast-icon toast-icon--target" data-lucide="clock-3"></i>
          </div>
        </div>
      </div>
      <div class="toast-message">Sin cambios pendientes</div>
    </div>

  </div>

  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    lucide.createIcons({
      attrs: {
        "stroke-width": 2.5
      }
    });
  </script>
</body>
</html>