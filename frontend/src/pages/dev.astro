---
import AppLayout from '../layouts/AppLayout.astro';
import ContentLoader from '../components/ui/ContentLoader.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import GooeyDropdown from '../components/ui/GooeyDropdown.astro';
import '../styles/calls.css';

const statusOptions = [
  { value: 'all', label: 'Todas' },
  { value: 'ended', label: 'Finalizadas' },
  { value: 'failed', label: 'Fallidas' },
];
---

<AppLayout title="Kognia — Modo dev">
  <section class="section-view section-view--dashboard analytics-dashboard" aria-label="Llamadas" data-dev-catalog>
    <div class="dashboard-page calls-page">
      <ContentLoader id="callsLoading" copy="Cargando llamadas…" class="dashboard-state" />
      <div id="callsContent" hidden inert aria-hidden="true">
        <header class="dashboard-topline">
          <div class="dashboard-heading"><h2>Llamadas</h2></div>
          <div class="dashboard-filters" aria-label="Buscar y filtrar llamadas">
            <label class="calls-search">
              <span class="sr-only">Buscar</span>
              <i class="calls-search__icon" data-lucide="search" aria-hidden="true"></i>
              <input id="callsSearch" type="search" placeholder="Buscar cliente o teléfono" autocomplete="off" />
            </label>
            <GooeyDropdown id="callsStatus" name="status" label="Estado" ariaLabel="Filtrar por estado" options={statusOptions} />
          </div>
        </header>
        <EmptyState id="callsError" class="dashboard-state" tone="error" icon="triangle-alert" title="No pudimos cargar las llamadas." role="alert" hidden>
          <button id="callsRetry" type="button">Reintentar</button>
        </EmptyState>
        <div class="calls-board" id="callsBoard" hidden>
          <div class="calls-table-card">
            <div class="calls-table-scroll" id="callsTable">
              <table class="calls-table">
                <colgroup>
                  <col class="calls-col-name" />
                  <col class="calls-col-phone" />
                  <col class="calls-col-start" />
                  <col class="calls-col-duration" />
                  <col class="calls-col-status" />
                  <col class="calls-col-view" />
                </colgroup>
                <thead>
                  <tr>
                    <th scope="col"><button type="button" data-sort="name">Cliente</button></th>
                    <th scope="col"><button type="button" data-sort="phone">Teléfono</button></th>
                    <th scope="col"><button type="button" data-sort="started">Inicio</button></th>
                    <th scope="col"><button type="button" data-sort="duration">Duración</button></th>
                    <th scope="col"><button type="button" data-sort="status">Estado</button></th>
                    <th scope="col"><span class="calls-view-label">Ver</span></th>
                  </tr>
                </thead>
                <tbody id="callsTableBody"></tbody>
              </table>
            </div>
            <EmptyState id="callsEmpty" class="calls-empty" icon="phone-off" title="Aún no hay llamadas." hidden />
          </div>
          <nav class="calls-pager" id="callsPager" aria-label="Paginación" hidden>
            <div class="calls-pager__controls" id="callsPagerControls"></div>
          </nav>
        </div>
      </div>
    </div>
  </section>
</AppLayout>

<script>
  import { bootDev } from '../features/dev/dev';
  import { accessTokenKey, checkSession, redirectToLogin } from '../features/auth/session-guard';
  import { waitForRouteSettle } from '../features/ui/loading-reveal';

  const apiUrl = document.body.dataset.apiUrl ?? '';
  let cleanup: (() => void) | null = null;
  let mounted = false;

  function isDevCatalogRoute(): boolean {
    return window.location.pathname === '/dev' || window.location.pathname === '/dev/';
  }

  async function mountDev(): Promise<void> {
    if (!isDevCatalogRoute()) return;
    if (mounted) return;
    const token = sessionStorage.getItem(accessTokenKey)?.trim();
    if (!token) {
      window.location.replace('/');
      return;
    }
    await waitForRouteSettle();
    if (!document.getElementById('callsLoading')) return;
    if (await checkSession(apiUrl) === 'invalid') {
      redirectToLogin();
      return;
    }
    cleanup?.();
    cleanup = bootDev(apiUrl, token);
    mounted = true;
  }

  function unmountDev(): void {
    cleanup?.();
    cleanup = null;
    mounted = false;
  }

  document.addEventListener('astro:before-swap', unmountDev);
  document.addEventListener('astro:page-load', () => { void mountDev(); });
  void mountDev();
</script>
