---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const source = readFileSync(join(process.cwd(), '..', 'demo-monitoreo'), 'utf8');
const cannedStart = source.indexOf('<div class="message-row customer timeline-item" data-at="1.0"');
const cannedEnd = source.indexOf('</section>', source.indexOf('id="callEndedEvent"'));
const withoutCanned =
  cannedStart >= 0 && cannedEnd >= 0
    ? `${source.slice(0, cannedStart)}${source.slice(cannedEnd)}`
    : source;

const debugControls = `            <div class="controls" aria-label="Controles de llamada">
              <div class="control-stack">
                <button class="control" type="button" id="rewindBtn" aria-label="Reiniciar llamada" title="Reiniciar llamada"><i data-lucide="rotate-ccw" aria-hidden="true"></i></button>
                <span class="control-caption">Reiniciar</span>
              </div>
              <div class="control-stack">
                <button class="control primary" type="button" id="startBtn" aria-label="Empezar llamada" title="Empezar llamada"><i data-lucide="phone" aria-hidden="true"></i></button>
                <span class="control-caption">Llamar</span>
              </div>
              <div class="control-stack">
                <button class="control" type="button" id="playBtn" aria-label="Pausar llamada" title="Pausar llamada"><i data-lucide="pause" aria-hidden="true"></i></button>
                <span class="control-caption">Pausa</span>
              </div>
            </div>`;

const controlsStart = withoutCanned.indexOf('<div class="controls" aria-label="Controles de reproducción">');
const liveBtnAt = withoutCanned.indexOf('id="liveBtn"');
const liveCaptionAt = withoutCanned.indexOf('En vivo', liveBtnAt);
const liveStackClose = withoutCanned.indexOf('</div>', liveCaptionAt);
const controlsClose = withoutCanned.indexOf('</div>', liveStackClose + 1);
const withControls =
  controlsStart >= 0 && controlsClose > controlsStart
    ? `${withoutCanned.slice(0, controlsStart)}${debugControls}${withoutCanned.slice(controlsClose + 6)}`
    : withoutCanned;

const adapted = withControls
  .replace('const DEMO_DURATION = 36;', 'const DEMO_DURATION = 3600;')
  .replace(
    "reconnect.classList.toggle('reconnected', reconnected);",
    "reconnect?.classList.toggle('reconnected', reconnected);",
  )
  .replace(
    "reconnectText.textContent = reconnected ? 'Reconectado · 2 s' : 'Reconectando';",
    "if (reconnectText) reconnectText.textContent = reconnected ? 'Reconectado · 2 s' : 'Reconectando';",
  )
  .replace(
    'setNameResolved(now >= 11.2, animateCrossings && crossedName);',
    '/* live: no resolver el nombre de la demo */',
  )
  .replace(/<nav class="demo-switcher"[\s\S]*?<\/nav>/, '')
  .replace(
    'function replacePlayIcon(name) {',
    'function replacePlayIcon(name) { if (window.__liveDebugControls) return;',
  )
  .replace(
    "playBtn.addEventListener('click', () => setPlaying(!playing));",
    "if (!window.__liveDebugControls) playBtn.addEventListener('click', () => setPlaying(!playing));",
  )
  .replace(
    "startBtn.addEventListener('click', () => seek(0));",
    "if (!window.__liveDebugControls) startBtn.addEventListener('click', () => seek(0));",
  )
  .replace(
    "liveBtn.addEventListener('click', jumpToLive);",
    "if (!window.__liveDebugControls) liveBtn.addEventListener('click', jumpToLive);",
  )
  .replace(
    "document.getElementById('rewindBtn').addEventListener('click', () => seek(current - 10));",
    "if (!window.__liveDebugControls) document.getElementById('rewindBtn').addEventListener('click', () => seek(current - 10));",
  )
  .replace(
    "document.getElementById('forwardBtn').addEventListener('click', () => seek(current + 10));",
    "if (!window.__liveDebugControls) document.getElementById('forwardBtn')?.addEventListener('click', () => seek(current + 10));",
  )
  .replace(
    'liveBtn.disabled = mode !== \'live\' || callEnded || atLiveEdge;',
    'if (liveBtn) liveBtn.disabled = mode !== \'live\' || callEnded || atLiveEdge;',
  )
  .replace(
    'liveBtn.hidden = mode !== \'live\' || callEnded;',
    'if (liveBtn) liveBtn.hidden = mode !== \'live\' || callEnded;',
  )
  .replace(
    'startBtn.disabled = current <= .01;',
    'if (!window.__liveDebugControls) startBtn.disabled = current <= .01;',
  )
  .replace(
    `      disconnectAnalyser() {
        externalAnalyser = null;
        analyserBins = null;
      },`,
    `      disconnectAnalyser() {
        externalAnalyser = null;
        analyserBins = null;
      },
      setPlaying,
      resetLiveWave() {
        liveSamples.length = 0;
        liveSamples.push(.025);
        liveEdge = 0;
        current = 0;
        sampleAccumulator = 0;
        callEnded = false;
        renderPlayer();
      },`,
  )
  .replace(
    `        liveEdge = Math.min(DEMO_DURATION, liveEdge + dt);

        sampleAccumulator += dt;
        while (sampleAccumulator >= SAMPLE_INTERVAL && liveEdge < DEMO_DURATION) {
          sampleAccumulator -= SAMPLE_INTERVAL;
          const sampleTime = Math.max(previousEdge, liveEdge - sampleAccumulator);
          if (externalAnalyser && analyserBins) {
            pushAmplitude(voiceLevelFromAnalyser(externalAnalyser, analyserBins, externalSampleRate));
          } else {
            pushFrequencyFrame(demoFrequencyFrame(sampleTime), 16000);
          }
        }`,
    `        const frozen = window.__liveDebugControls && !playing;
        if (!frozen) liveEdge = Math.min(DEMO_DURATION, liveEdge + dt);
        if (frozen) sampleAccumulator = 0;
        else sampleAccumulator += dt;
        while (!frozen && sampleAccumulator >= SAMPLE_INTERVAL && liveEdge < DEMO_DURATION) {
          sampleAccumulator -= SAMPLE_INTERVAL;
          const sampleTime = Math.max(previousEdge, liveEdge - sampleAccumulator);
          if (externalAnalyser && analyserBins) {
            try {
              externalAnalyser.getByteFrequencyData(analyserBins);
              pushFrequencyFrame(analyserBins, externalSampleRate);
            } catch {
              try { pushAmplitude(voiceLevelFromAnalyser(externalAnalyser, analyserBins, externalSampleRate)); }
              catch { pushAmplitude(.04); }
            }
          } else if (!window.__liveDebugControls) {
            pushFrequencyFrame(demoFrequencyFrame(sampleTime), 16000);
          }
        }`,
  )
  .replace(
    "setMode('live');\n    requestAnimationFrame(tick);",
    "setMode('live');\n    if (window.__liveDebugControls) setPlaying(false);\n    requestAnimationFrame(tick);",
  );

const head = adapted.match(/<head>([\s\S]*?)<\/head>/i)?.[1] ?? '';
const body = adapted.match(/<body>([\s\S]*?)<\/body>/i)?.[1] ?? '';
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:18474';
---
<html lang="es">
  <head>
    <Fragment set:html={head} />
    <style>
      .demo-switcher { display: none !important; }
    </style>
  </head>
  <body data-api-url={apiUrl}>
    <script is:inline>window.__liveDebugControls = true;</script>
    <Fragment set:html={body} />
    <script>
      import { bootLiveMonitor } from '../features/voice-call/application/live-monitor';
      bootLiveMonitor(document.body.dataset.apiUrl ?? 'http://localhost:18474');
    </script>
  </body>
</html>
