    .agent .message { background: var(--ui-graphite); color: var(--ui-paper); }
    .customer .message { margin-left: auto; background: var(--ui-cream); color: var(--ui-graphite); }

    .token {
      display: inline;
      opacity: 0;
      filter: blur(3px);
      transform: translateY(4px);
      animation: token-in .34s cubic-bezier(.2,.76,.24,1) forwards;
    }

    @keyframes token-in { to { opacity: 1; filter: blur(0); transform: translateY(0); } }

    .message-time {
      display: inline-block;
      margin-left: 8px;
      font-size: 11px;
      font-weight: 600;
      opacity: 0;
