---
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:18474';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Starter FastAPI + Astro para hackathon" />
    <title>Hackathon Stack</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">FastAPI · Python 3.13 · Astro · Vite</p>
      <h1>Stack listo para construir rápido.</h1>
      <p id="status">Consultando backend…</p>
    </main>

    <script define:vars={{ apiUrl }}>
      const status = document.querySelector('#status');

      fetch(`${apiUrl}/api/hello`)
        .then((response) => {
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          return response.json();
        })
        .then((data) => {
          status.textContent = data.message;
        })
        .catch((error) => {
          status.textContent = `Backend no disponible: ${error.message}`;
        });
    </script>

    <style>
      :global(*) { box-sizing: border-box; }
      :global(body) {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: Inter, ui-sans-serif, system-ui, sans-serif;
        background: #0b0d10;
        color: #f5f7fa;
      }
      main { width: min(720px, 90vw); }
      .eyebrow { opacity: .65; font-size: .9rem; letter-spacing: .08em; text-transform: uppercase; }
      h1 { font-size: clamp(2.5rem, 8vw, 5rem); line-height: .95; margin: .4rem 0 1.5rem; }
      #status { font-size: 1.1rem; opacity: .8; }
    </style>
  </body>
</html>
