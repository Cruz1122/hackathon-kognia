---
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:18474';
 import AppNav from '../components/navigation/AppNav.astro';
import AnalyticsContent from '../components/dashboard/AnalyticsContent.astro';
import '../styles/toast.css';
import '../styles/detail-panel.css';
import '../styles/dashboard.css';
---
<html lang="es" transition:animate="none">
  <head>

  <meta charset="utf-8" />
   <meta name="viewport" content="width=device-width, initial-scale=1" />
   <title>Monitoreo de llamadas — Demo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Urbanist:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest" is:inline></script>
  <style is:inline>
    :root {
      --ui-graphite: #414141;
      --ui-amber: #f7c974;
      --ui-cream: #faeccf;
      --ui-paper: #f8f8f8;
      --ui-control: var(--ui-cream);
      --rail-share: min(17.5%, 21rem);
      --rail: var(--rail-share);
      --font-ui: "Urbanist", sans-serif;
      --radius-full: 9999px;
      --radius-min: 14px;
      --radius-max: 32px;
      --radius-ui: min(var(--radius-max), 50%);
    }

    @property --left-rail {
      syntax: '<length-percentage>';
      inherits: false;
      initial-value: 56%;
    }

    @property --right-rail {
      syntax: '<length-percentage>';
      inherits: false;
      initial-value: 0%;
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      min-height: 100%;
      background: var(--ui-paper);
      color: var(--ui-graphite);
      font-family: var(--font-ui);
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    button { font: inherit; color: inherit; }

    .page {
      width: 100%;
      margin: 0;
      padding: 0;
    }

    .app-content[hidden], .state-view[hidden], .auth-panel[hidden] { display: none !important; }

    .auth-panel {
      position: relative;
      display: grid;
      --left-rail: 56%;
      --right-rail: 0%;
      grid-template-columns: minmax(0, var(--left-rail)) minmax(0, 1fr) minmax(0, var(--right-rail));
      width: 100%;
      min-height: 100dvh;
      margin: 0;
      padding: 0;
      background: var(--ui-paper);
      overflow: hidden;
      transition:
        --left-rail 1.55s cubic-bezier(.32, .04, .18, 1),
        --right-rail 1.55s cubic-bezier(.32, .04, .18, 1);
    }

    .auth-panel.is-app {
      --left-rail: var(--rail-share);
      --right-rail: var(--rail-share);
    }

    .auth-panel.is-app.is-empty-view {
      --right-rail: 0%;
    }

    .login-left {
      position: relative;
      z-index: 1;
      min-width: 0;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: visible;
      background: var(--ui-graphite);
      padding: 48px 28px;
      transition: padding 1.55s cubic-bezier(.32, .04, .18, 1);
    }

    .auth-panel.is-app .login-left {
      align-items: stretch;
      justify-content: flex-start;
      padding: 28px 22px 32px;
      overflow: visible;
    }

    .login-sidebar {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: min(100%, 360px);
      min-width: 0;
      max-width: 100%;
      transition: width 1.55s cubic-bezier(.32, .04, .18, 1);
    }

    .auth-panel.is-app .login-sidebar {
      width: 100%;
      flex: 1;
      align-items: stretch;
    }

    /* Dos teselas idénticas: al desplazar una tesela completa, el último
       fotograma es exactamente igual al primero y el loop no salta. */
    .login-material {
      position: absolute;
      inset: -100% 0 auto auto;
      right: -6%;
      width: 24%;
      height: 200%;
      transform-origin: 100% 50%;
      --material-enter-from: scaleX(.16);
      filter: url(#ui-goo);
      -webkit-filter: url(#ui-goo);
      will-change: width, height, opacity, transform;
      transition:
        width .85s cubic-bezier(.32, .04, .18, 1) 1.55s,
        height .85s cubic-bezier(.32, .04, .18, 1) 1.55s,
        right .85s cubic-bezier(.32, .04, .18, 1) 1.55s,
        left .85s cubic-bezier(.32, .04, .18, 1) 1.55s,
        bottom .85s cubic-bezier(.32, .04, .18, 1) 1.55s;
    }

    .login-material.is-gone {
      display: none !important;
    }

    .auth-panel.is-resizing,
    .auth-panel.is-resizing .login-left,
    .auth-panel.is-resizing .login-sidebar,
    .auth-panel.is-resizing .login-brand,
    .auth-panel.is-resizing .login-face-wrap,
    .auth-panel.is-resizing .login-name,
    .auth-panel.is-resizing .login-material,
    .login-material.is-resizing {
      transition: none !important;
      animation: none !important;
    }

    .login-material.is-resizing {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .login-material.is-entering {
      animation: material-enter .7s cubic-bezier(.32, .04, .18, 1) both;
    }

    .login-left-svg { display: block; width: 100%; height: 100%; }
    .login-left-svg--y { animation: liquid-flow 12s linear infinite; }
    .login-left-svg--x { display: none; animation: liquid-flow-x 12s linear infinite; }
    .amber-shape { fill: var(--ui-amber); }
    .graphite-shape { fill: var(--ui-graphite); }

    @keyframes liquid-flow {
      from { transform: translateY(0); }
      to { transform: translateY(50%); }
    }

    @keyframes liquid-flow-x {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    @keyframes material-enter {
      from {
        opacity: 0;
        transform: var(--material-enter-from);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }

    .login-brand {
      position: relative;
      z-index: 2;
      display: flex;
      width: 100%;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      color: var(--ui-amber);
      text-align: center;
      gap: 0;
      transition:
        gap 1.55s cubic-bezier(.32, .04, .18, 1),
        color 1.55s cubic-bezier(.32, .04, .18, 1);
    }

    .login-topbar {
      display: flex;
      width: 100%;
      align-items: center;
    }

    .auth-panel.is-app .login-brand {
      flex-direction: row;
      justify-content: flex-start;
      text-align: left;
      gap: 12px;
      color: var(--ui-paper);
    }

    .login-face-wrap {
      position: relative;
      isolation: isolate;
      width: min(55%, 280px);
      aspect-ratio: 1;
      border-radius: var(--radius-full);
      cursor: pointer;
      user-select: none;
      transform: translateZ(0);
      transition: width 1.55s cubic-bezier(.32, .04, .18, 1);
    }

    .login-face {
      display: block;
      width: 100%;
      height: auto;
      overflow: visible;
      pointer-events: none;
      transform: translateZ(0);
      backface-visibility: hidden;
    }

    .login-face-hit {
      position: absolute;
      inset: 0;
      z-index: 1;
      border: 0;
      border-radius: var(--radius-full);
      background: transparent;
      cursor: pointer;
      user-select: none;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
    }

    .auth-panel.is-app .login-face-wrap {
      width: 48px;
      flex-shrink: 0;
    }

    .auth-panel.is-app .login-material {
      width: 0;
      right: 0;
    }

    .login-face-wrap:focus-visible { outline: 4px solid var(--ui-paper); outline-offset: 8px; }

    .face-eye-assembly {
      will-change: transform;
    }

    .face-lid {
      transform-box: view-box;
    }

    .face-mouth,
    .face-folds {
      transform-box: view-box;
      transform-origin: 256px 340px;
    }

    .login-name {
      width: min(80%, 300px);
      margin-top: 22px;
      font-size: clamp(2.2rem, 4vw, 4rem);
      font-weight: 800;
      line-height: 1;
      letter-spacing: -.04em;
      transition:
        font-size 1.55s cubic-bezier(.32, .04, .18, 1),
        margin-top 1.55s cubic-bezier(.32, .04, .18, 1),
        width 1.55s cubic-bezier(.32, .04, .18, 1);
    }

    .auth-panel.is-app .login-name {
      width: auto;
      margin-top: 0;
      font-size: 1.65rem;
      font-weight: 800;
    }

    .app-nav {
      width: 100%;
      min-width: 0;
      height: 0;
      margin-top: 0;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      gap: 6px;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(16px);
      transition:
        opacity .7s cubic-bezier(.32, .04, .18, 1),
        transform .85s cubic-bezier(.32, .04, .18, 1),
        visibility 0s .75s;
    }

    .auth-panel.is-app.is-nav-ready .app-nav {
      height: auto;
      overflow-x: hidden;
      overflow-y: auto;
      margin-top: 40px;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: none;
      transition:
        opacity .7s cubic-bezier(.32, .04, .18, 1),
        transform .85s cubic-bezier(.32, .04, .18, 1),
       visibility 0s;
    }

    .mobile-nav-toggle { display: none; }
    .mobile-nav-toggle[hidden] { display: none !important; }

    .app-nav__item,
    .app-nav__label {
      display: grid;
      grid-template-columns: 28px minmax(0, 1fr);
      align-items: center;
      gap: 16px;
      width: min(100%, 320px);
      min-width: 0;
      margin: 0 auto;
      border: 0;
      border-radius: var(--radius-full);
      background: transparent;
      color: var(--ui-paper);
      font: inherit;
      font-size: clamp(1.05rem, 1.35vw, 1.35rem);
      font-weight: 700;
      line-height: 1.2;
      text-align: left;
      padding: 16px 18px;
      cursor: pointer;
      white-space: nowrap;
      transition: color .24s ease, transform .24s ease;
    }

    .app-nav__item span,
    .app-nav__label span {
      min-width: 0;
      white-space: nowrap;
    }

    .app-nav__label {
      opacity: .78;
    }

    .app-nav__label.is-active {
      opacity: 1;
      color: var(--ui-amber);
    }

    .app-nav__item svg,
    .app-nav__label svg {
      width: clamp(22px, 2vw, 28px);
      height: clamp(22px, 2vw, 28px);
      flex-shrink: 0;
      stroke-width: 2.3;
    }

    .app-nav__item:not(.app-nav__item--disabled):hover,
    .app-nav__label:hover {
      background: transparent;
      color: var(--ui-amber);
      transform: translateX(3px);
    }

    .app-nav__item:focus-visible,
    .app-nav__label:focus-visible {
      outline: 3px solid var(--ui-amber);
      outline-offset: 2px;
    }

    .app-nav__item.is-active {
      color: var(--ui-amber);
    }

    .app-nav__group {
      display: flex;
      width: 100%;
      flex-direction: column;
      gap: 4px;
    }

    .app-nav__children {
      display: grid;
      grid-template-rows: 0fr;
      width: min(100%, 320px);
      margin-inline: auto;
      padding-left: 44px;
      min-width: 0;
      transition: grid-template-rows .45s cubic-bezier(.32, .04, .18, 1);
    }

    .app-nav__group.is-open .app-nav__children {
      grid-template-rows: 1fr;
    }

    .app-nav__children-inner {
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-height: 0;
      overflow: hidden;
    }

    .app-nav__children .app-nav__item {
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
      margin-inline: 0;
      font-size: 1.2rem;
      font-weight: 600;
      padding: 12px 16px;
      white-space: nowrap;
    }

    .app-nav__call {
      font-style: italic;
      font-weight: 500;
      opacity: .88;
    }

    .app-nav__call.is-active {
      opacity: 1;
    }

    .login-right {
      position: relative;
      z-index: 0;
      min-width: 0;
      min-height: 100dvh;
      padding: 0;
      overflow: hidden;
      background: var(--ui-paper);
    }

    .login-form-content {
      position: absolute;
      left: 50%;
      top: 50%;
      z-index: 1;
      width: min(calc(100% - 50px), 430px);
      transform: translate(-50%, -50%);
      transition: opacity .55s cubic-bezier(.32, .04, .18, 1), transform .55s cubic-bezier(.32, .04, .18, 1);
    }

    .auth-panel.is-app .login-form-content {
      opacity: 0;
      pointer-events: none;
      transform: translate(-50%, -50%) translateX(-12px);
    }

    .app-content {
      position: absolute;
      inset: 0;
      z-index: 1;
      overflow: hidden;
      scrollbar-width: thin;
      scrollbar-color: transparent transparent;
      width: 100%;
      padding: 0 clamp(16px, 3vw, 40px) 84px;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(22px);
      transform-origin: 50% 8%;
      transition:
        opacity .9s cubic-bezier(.32, .04, .18, 1),
        transform 1.35s cubic-bezier(.32, .04, .18, 1),
        visibility 0s 1.4s;
    }

    .app-content.is-scrolling {
      scrollbar-color: rgba(65, 65, 65, .28) transparent;
    }

    .app-content::-webkit-scrollbar {
      width: 8px;
    }

    .app-content::-webkit-scrollbar-track {
      background: transparent;
    }

    .app-content::-webkit-scrollbar-thumb {
      background-color: transparent;
      border-radius: var(--radius-ui);
      border: 2px solid transparent;
      background-clip: padding-box;
      transition: background-color .45s cubic-bezier(.32, .04, .18, 1);
    }

    .app-content.is-scrolling::-webkit-scrollbar-thumb {
      background-color: rgba(65, 65, 65, .28);
    }

    .auth-panel.is-app .app-content {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: none;
      transition:
        opacity .95s .18s cubic-bezier(.32, .04, .18, 1),
        transform 1.4s .12s cubic-bezier(.32, .04, .18, 1),
        visibility 0s 0s;
    }

    .auth-panel.is-app.is-nav-ready .app-content {
      overflow-x: hidden;
      overflow-y: auto;
    }

    .auth-panel.is-app.is-empty-view .app-content {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      overflow: hidden;
      transform: translateY(18px);
      transition:
        opacity .55s cubic-bezier(.32, .04, .18, 1),
        transform .7s cubic-bezier(.32, .04, .18, 1),
        visibility 0s .6s;
    }

    .login-right > .section-view {
      position: absolute;
      inset: 0;
      z-index: 2;
      min-height: 100dvh;
      display: grid;
      place-items: center;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(18px);
      transition:
        opacity .75s cubic-bezier(.32, .04, .18, 1),
        transform 1.1s cubic-bezier(.32, .04, .18, 1),
        visibility 0s .8s;
    }

    .login-right > .section-view.is-active {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: none;
      transition:
        opacity .75s cubic-bezier(.32, .04, .18, 1),
        transform 1.1s cubic-bezier(.32, .04, .18, 1),
        visibility 0s;
    }

    .app-content .player {
      opacity: 0;
      transform: translateY(14px) scaleX(.92);
      transform-origin: 50% 100%;
      transition:
        opacity .7s cubic-bezier(.32, .04, .18, 1),
        transform 1.2s cubic-bezier(.32, .04, .18, 1);
    }

    .auth-panel.is-app .app-content .player {
      opacity: 1;
      transform: none;
      transition-delay: .28s, .2s;
    }

    .app-content .conversation {
      opacity: 0;
      transform: translateY(32px);
      transition:
        opacity .75s cubic-bezier(.32, .04, .18, 1),
        transform 1.25s cubic-bezier(.32, .04, .18, 1);
    }

    .auth-panel.is-app .app-content .conversation {
      opacity: 1;
      transform: none;
      transition-delay: .48s, .38s;
    }

    .login-right > .state-view {
      position: absolute;
      inset: 0;
      min-height: 0;
    }

    .auth-panel.no-wipe,
    .auth-panel.no-wipe .login-form-content,
    .auth-panel.no-wipe .app-content,
    .auth-panel.no-wipe .app-content .player,
    .auth-panel.no-wipe .app-content .conversation,
    .auth-panel.no-wipe .login-left,
    .auth-panel.no-wipe .login-sidebar,
    .auth-panel.no-wipe .login-brand,
    .auth-panel.no-wipe .login-face-wrap,
    .auth-panel.no-wipe .login-name,
    .auth-panel.no-wipe .login-material,
    .auth-panel.no-wipe .app-nav,
    .auth-panel.no-wipe .app-nav__children,
    .auth-panel.no-wipe .section-view,
    .auth-panel.no-wipe .detail-panel,
    .auth-panel.no-wipe .detail-kicker,
    .auth-panel.no-wipe .detail-title,
    .auth-panel.no-wipe .detail-field {
      transition: none !important;
    }

    .auth-copy { display: grid; gap: 5px; margin-bottom: 42px; }
    .auth-copy h2 { margin: 0; font-size: clamp(2.5rem, 4vw, 4rem); line-height: .95; letter-spacing: -.04em; font-weight: 800; }
    .auth-copy p:last-child { margin: 0; color: rgba(65,65,65,.68); font-size: 14px; line-height: 1.35; }

    .login-left,
    .login-right { min-width: 0; }

    .auth-form { display: grid; gap: 0; width: min(100%, 430px); }
    .auth-field { display: grid; gap: 8px; min-width: 0; margin-bottom: 22px; }
    .auth-field span { padding-inline: 14px; font-size: 14px; font-weight: 700; }
    .auth-field input {
      width: 100%;
      height: 54px;
      border: 4px solid var(--ui-graphite);
      border-radius: var(--radius-ui);
      padding: 0 18px;
      background: transparent;
      color: var(--ui-graphite);
      font: inherit;
      font-size: 18px;
      outline: 0;
    }
    .auth-field input:focus-visible { outline: 3px solid var(--ui-amber); outline-offset: 2px; }
    .auth-password-field {
      grid-template-columns: minmax(0, 1fr);
    }
    .auth-password-field input {
      grid-area: 2 / 1;
      min-width: 0;
      padding-right: 62px;
      font-size: 18px;
      letter-spacing: 0;
    }
    .auth-password-toggle {
      position: relative;
      grid-area: 2 / 1;
      justify-self: end;
      align-self: center;
      z-index: 1;
      margin-right: 8px;
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      border: 0;
      border-radius: var(--radius-ui);
      background: transparent;
      color: var(--ui-graphite);
      cursor: pointer;
    }
    .auth-password-toggle:hover { background: var(--ui-cream); }
    .auth-password-toggle:focus-visible { outline: 3px solid var(--ui-amber); outline-offset: 2px; }
    .auth-password-toggle svg { width: 20px; height: 20px; stroke-width: 2.5; }
    .auth-submit-wrap { position: relative; height: 58px; margin-top: 3px; overflow: visible; }
    .auth-submit-wrap::before {
      content: "";
      position: absolute;
      inset: 6px -8px -10px 8px;
      border-radius: var(--radius-ui);
      background: var(--ui-amber);
      filter: url(#ui-goo);
      -webkit-filter: url(#ui-goo);
    }
    .auth-submit {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 58px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 0;
      border-radius: var(--radius-ui);
      background: var(--ui-graphite);
      color: var(--ui-paper);
      font-size: 20px;
      font-weight: 700;
      cursor: pointer;
    }
    .auth-submit:disabled { cursor: wait; }
    .auth-submit:focus-visible { outline: 3px solid var(--ui-amber); outline-offset: 3px; }
    .auth-submit-label {
      transition: opacity .28s cubic-bezier(.32, .04, .18, 1);
    }
    .auth-submit.is-loading .auth-submit-label {
      opacity: 0;
    }
    .auth-submit-loader {
      position: absolute;
      left: 50%;
      top: 50%;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 8px;
      transform: translate(-50%, -50%);
      opacity: 0;
      pointer-events: none;
      transition: opacity .28s cubic-bezier(.32, .04, .18, 1);
    }
    .auth-submit-wrap.is-loading .auth-submit-loader { opacity: 1; }
    .auth-submit-loader-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--ui-amber);
      animation: auth-dot 1s ease-in-out infinite;
    }
    .auth-submit-loader-dot:nth-child(2) { animation-delay: .15s; }
    .auth-submit-loader-dot:nth-child(3) { animation-delay: .3s; }
    @keyframes auth-dot {
      0%, 80%, 100% { transform: scale(.7); opacity: .4; }
      40% { transform: scale(1); opacity: 1; }
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .topline {
      display: flex;
      align-items: flex-end;
      justify-content: flex-end;
      gap: 24px;
      width: 100%;
      margin-inline: auto;
      padding: 0 10px 18px;
    }

    h1 {
      margin: 0;
      font-size: clamp(26px, 3vw, 38px);
      line-height: 1.03;
      letter-spacing: -.035em;
      font-weight: 800;
    }

    .call-meta {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 8px;
      flex-wrap: wrap;
    }

    .chip {
      --chip-height: 40px;
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: var(--chip-height);
      min-width: 96px;
      padding: 0 16px;
      border-radius: calc(var(--chip-height) / 2);
      background: rgba(65,65,65,.07);
      font-size: 13px;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
    }

    .name-chip { min-width: 104px; }
    .name-value { display: inline-block; transform-origin: 50% 50%; }
    .name-chip.updating { animation: chip-squish .64s cubic-bezier(.22,.9,.28,1); }
    .name-chip.updating .name-value { animation: name-swap .64s cubic-bezier(.22,.9,.28,1); }

    @keyframes chip-squish {
      0% { transform: scaleX(1); }
      34% { transform: scaleX(.82) scaleY(1.08); }
      68% { transform: scaleX(1.045) scaleY(.96); }
      100% { transform: scale(1); }
    }

    @keyframes name-swap {
      0% { opacity: 1; transform: translateY(0); }
      35% { opacity: 0; transform: translateY(-8px); }
      52% { opacity: 0; transform: translateY(8px); }
      100% { opacity: 1; transform: translateY(0); }
    }

    .chip.mode-live { background: var(--ui-amber); font-weight: 800; }
    .chip.mode-recorded { background: var(--ui-cream); font-weight: 800; }

    .live-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--ui-graphite);
      animation: live-pulse 1.65s ease-in-out infinite;
    }

    @keyframes live-pulse {
      0%, 100% { transform: scale(.82); opacity: .48; }
      50% { transform: scale(1); opacity: 1; }
    }

    .player-wrap {
      position: sticky;
      top: 0;
      z-index: 20;
      margin: 0 calc(-1 * clamp(16px, 3vw, 40px));
      padding: 18px clamp(16px, 3vw, 40px) 16px;
      background: var(--ui-paper);
    }

    .player {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 24px;
      width: 100%;
      margin-inline: auto;
      padding: 6px 10px 2px;
      color: var(--ui-graphite);
    }

    .monitor {
      min-width: 0;
      height: 72px;
      position: relative;
      cursor: pointer;
      user-select: none;
      touch-action: none;
      outline: none;
      --progress: 100%;
    }

    .monitor:focus-visible .progress-shell { box-shadow: 0 0 0 3px rgba(247,201,116,.58); }

    .wave-window {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 13px;
      height: 46px;
      overflow: hidden;
      pointer-events: none;
      opacity: 1;
      transform-origin: 50% 100%;
      transition: opacity .13s ease, transform .16s cubic-bezier(.2,.8,.2,1);
    }

    .monitor.seeking .wave-window {
      opacity: 0;
      transform: translateY(9px) scaleY(.72);
    }

    .wave-canvas {
      width: 100%;
      height: 100%;
      display: block;
      max-width: 100%;
      object-fit: fill;
    }

    .progress-shell {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 5px;
      height: 10px;
      border-radius: var(--radius-ui);
      background: rgba(65,65,65,.10);
      overflow: visible;
      transition: height .16s ease, bottom .16s ease;
    }

    .monitor.seeking .progress-shell { height: 12px; bottom: 4px; }

    .progress-fill {
      width: var(--progress);
      height: 100%;
      border-radius: inherit;
      background: var(--ui-amber);
    }

    .playhead {
      position: absolute;
      left: var(--progress);
      top: 50%;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--ui-graphite);
      transform: translate(-50%, -50%);
      box-shadow: 0 0 0 4px rgba(248,248,248,.92);
      pointer-events: none;
      transition: left .08s linear;
    }

    .monitor.at-live-edge .playhead {
      width: 15px;
      height: 15px;
    }

    .transport {
      display: grid;
      justify-items: end;
      align-content: end;
      gap: 8px;
      padding-bottom: 2px;
    }

    .timecode {
      font-variant-numeric: tabular-nums;
      font-size: 13px;
      line-height: 1;
      font-weight: 700;
      white-space: nowrap;
      opacity: .72;
    }

    .controls { display: flex; align-items: flex-start; gap: 8px; }
    .control-stack { display: grid; justify-items: center; gap: 3px; }

    .control-caption {
      font-size: 9px;
      line-height: 1;
      font-weight: 800;
      letter-spacing: .02em;
      opacity: .48;
      font-variant-numeric: tabular-nums;
    }

    .control {
      width: 40px;
      height: 40px;
      padding: 0;
      border: 0;
      border-radius: 50%;
