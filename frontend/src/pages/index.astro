                  <path id="leftFaceFold" d="M 142 166 C 166 156 188 154 209 160" />
                  <path id="rightFaceFold" d="M 303 160 C 324 154 346 156 370 166" />
                </g>

                <path class="face-mouth" id="faceMouth" d="M 141 319 C 181 369 331 369 371 319" fill="none" stroke="#414141" stroke-width="32" stroke-linecap="round" stroke-linejoin="round" />
