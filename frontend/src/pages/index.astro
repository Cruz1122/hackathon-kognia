              <path class="graphite-shape" d="M0 0 H540 C540 60 468 140 450 260 C432 380 513 500 459 620 C405 740 513 860 450 980 C432 1080 540 1160 540 1200 H0 Z" />
            </g>
            <g transform="translate(0 1200)">
              <path class="amber-shape" d="M0 0 H600 C600 60 520 140 500 260 C480 380 570 500 510 620 C450 740 570 860 500 980 C480 1080 600 1160 600 1200 H0 Z" />
              <path class="graphite-shape" d="M0 0 H540 C540 60 468 140 450 260 C432 380 513 500 459 620 C405 740 513 860 450 980 C432 1080 540 1160 540 1200 H0 Z" />
            </g>
          </svg>
          <svg class="login-left-svg login-left-svg--x" viewBox="0 0 2400 600" preserveAspectRatio="none">
            <g>
              <path class="amber-shape" d="M0 0 H1200 V600 C1140 600 1060 520 940 500 C820 480 700 570 580 510 C460 450 340 570 220 500 C140 480 40 600 0 600 Z" />
              <path class="graphite-shape" d="M0 0 H1200 V540 C1140 540 1060 468 940 450 C820 432 700 513 580 459 C460 405 340 513 220 450 C140 432 40 540 0 540 Z" />
            </g>
            <g transform="translate(1200 0)">
              <path class="amber-shape" d="M0 0 H1200 V600 C1140 600 1060 520 940 500 C820 480 700 570 580 510 C460 450 340 570 220 500 C140 480 40 600 0 600 Z" />
              <path class="graphite-shape" d="M0 0 H1200 V540 C1140 540 1060 468 940 450 C820 432 700 513 580 459 C460 405 340 513 220 450 C140 432 40 540 0 540 Z" />
