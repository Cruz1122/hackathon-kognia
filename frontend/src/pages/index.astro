    .done-mark i, .done-mark svg { width: 19px; height: 19px; stroke-width: 2.5; }
    .tool-call.done .done-mark { animation: done-pop .54s .18s cubic-bezier(.16,.9,.25,1) forwards; }

    @keyframes done-pop {
      66% { opacity: 1; transform: scale(1.12); }
      100% { opacity: 1; transform: scale(1); }
    }

    .system-event.call-ended {
      color: var(--ui-graphite);
      font-weight: 800;
    }

    .call-ended-label {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 0;
      border-radius: 0;
      background: transparent;
    }

    .call-ended-label svg {
      width: 14px;
      height: 14px;
      stroke-width: 2.5;
    }

    .mode-end-icon {
      display: inline-grid;
      place-items: center;
