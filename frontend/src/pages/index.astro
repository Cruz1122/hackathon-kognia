    .timeline-item.visible { visibility: visible; pointer-events: auto; }
    .timeline-item.enter { animation: item-in .52s cubic-bezier(.2,.82,.2,1) both; }
    .timeline-item.visible:not(.enter) { opacity: 1; transform: none; }

    @keyframes item-in {
