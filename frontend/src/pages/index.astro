    .message.complete .message-time { animation: timestamp-in .35s ease forwards; }
    @keyframes timestamp-in { to { opacity: .48; transform: translateY(0); } }

    .system-event {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 14px;
      margin: 31px 0;
      color: rgba(65,65,65,.52);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .02em;
    }

    .system-event::before, .system-event::after {
      content: "";
      height: 1px;
      background: rgba(65,65,65,.16);
      transform-origin: center;
    }

    .system-event.enter::before, .system-event.enter::after { animation: line-open .72s cubic-bezier(.2,.8,.2,1) both; }
    @keyframes line-open { from { transform: scaleX(0); opacity: 0; } to { transform: scaleX(1); opacity: 1; } }

    .reconnect-label {
      display: inline-flex;
      align-items: center;
      padding: 0;
      background: transparent;
      border-radius: 0;
      overflow: visible;
    }

    /* El evento sigue animado, pero sin superficie tipo badge. */
    .reconnect-mass,
    .reconnect-shine { display: none; }

    #reconnectText {
      display: inline-block;
      transform-origin: 50% 50%;
      animation: reconnect-text-pulse 1.22s cubic-bezier(.45,.04,.3,1) infinite;
    }

    @keyframes reconnect-text-pulse {
      0%,100% { opacity: .46; transform: scaleX(.97); }
      48% { opacity: .92; transform: scaleX(1.035); }
      72% { opacity: .64; transform: scaleX(.992); }
    }

    .system-event.reconnected #reconnectText { animation: none; opacity: 1; transform: none; }

    .tool-row { display: flex; justify-content: flex-start; margin: 21px 0; }

    .tool-call {
      appearance: none;
      border: 0;
      font: inherit;
      text-align: left;
      cursor: pointer;
      position: relative;
      width: min(520px, 84%);
      min-height: 82px;
      border-radius: var(--radius-ui);
      background: var(--ui-graphite);
      color: var(--ui-paper);
      padding: 15px 76px 15px 18px;
      display: flex;
      align-items: center;
      gap: 14px;
      overflow: visible;
      transform-origin: 0 50%;
    }

    .tool-call:focus-visible {
      outline: 3px solid var(--ui-amber);
      outline-offset: 3px;
    }

    .tool-row.enter .tool-call { animation: tool-arrive .72s cubic-bezier(.16,.9,.28,1) both; }

    @keyframes tool-arrive {
      0% { opacity: 0; transform: translateX(-18px) scaleX(.78) scaleY(.94); }
      58% { opacity: 1; transform: translateX(2px) scaleX(1.035) scaleY(.985); }
      78% { transform: translateX(0) scaleX(.988) scaleY(1.025); }
      100% { opacity: 1; transform: none; }
    }

    .tool-icon {
      flex: 0 0 auto;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: var(--ui-paper);
      color: var(--ui-graphite);
      position: relative;
      z-index: 2;
