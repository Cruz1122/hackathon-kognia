      72% { opacity: 1; transform: translateY(-1px) scale(1.004); }
      100% { opacity: 1; transform: none; }
    }

    .message-row { display: flex; margin: 20px 0; }
    .message-row.agent { justify-content: flex-start; }
    .message-row.customer { justify-content: flex-end; }

    .message-wrap { max-width: min(66ch, 76%); display: grid; gap: 7px; }

    .message-meta {
      display: flex;
