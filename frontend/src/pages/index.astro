  <div class="toast-stack" aria-live="polite" aria-atomic="true"></div>

  <main class="page">
    <section class="auth-panel" id="authPanel" aria-labelledby="authTitle">
      <section class="login-left" aria-label="Demo">
        <div class="login-material" aria-hidden="true">
          <svg class="login-left-svg login-left-svg--y" viewBox="0 0 600 2400" preserveAspectRatio="none">
            <g>
