        </div>

    <script is:inline>
      (() => {
        const face = document.getElementById('demoFace');
        const faceHit = document.getElementById('demoFaceHit');
        const faceWrap = document.getElementById('demoFaceWrap');
        const authPanel = document.getElementById('authPanel');
        const form = document.getElementById('authForm');
        const email = document.getElementById('authEmail');
        const password = document.getElementById('authPassword');
        const leftEyeAssembly = document.getElementById('leftEyeAssembly');
        const rightEyeAssembly = document.getElementById('rightEyeAssembly');
        const leftEye = document.getElementById('leftFaceEye');
        const rightEye = document.getElementById('rightFaceEye');
        const mouth = document.getElementById('faceMouth');
        const folds = document.getElementById('faceFolds');
        const leftFold = document.getElementById('leftFaceFold');
        const rightFold = document.getElementById('rightFaceFold');
        const lids = {
          lt: document.getElementById('leftTopLid'),
          rt: document.getElementById('rightTopLid'),
          lb: document.getElementById('leftBottomLid'),
          rb: document.getElementById('rightBottomLid'),
        };
        if (!face || !faceHit || !faceWrap || !form || !email || !password || !leftEye || !rightEye || !mouth || !folds || !leftFold || !rightFold) return;

        const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const emotions = {
          happy: { mouth: 'M 141 319 C 181 369 331 369 371 319', stroke: 32, gazeX: 0, gazeY: 0, top: 0, bottom: 0, leftAngle: 0, rightAngle: 0, hideLids: true },
          neutral: { mouth: 'M 166 340 C 211 340 301 340 346 340', stroke: 28, gazeX: 0, gazeY: 0, top: 0, bottom: 0, leftAngle: 0, rightAngle: 0 },
          sad: { mouth: 'M 151 363 C 195 311 317 311 361 363', stroke: 30, gazeX: 0, gazeY: 5, top: 10, bottom: 0, leftAngle: -15, rightAngle: 15 },
          worried: { mouth: 'M 148 354 C 185 318 213 375 256 344 C 299 313 327 370 364 342', stroke: 27, gazeX: 0, gazeY: 3, top: 7, bottom: 0, leftAngle: -20, rightAngle: 20, folds: ['M 137 181 C 162 169 185 157 210 153', 'M 302 153 C 327 157 350 169 375 181'] },
          angry: { mouth: 'M 168 357 C 207 320 305 320 344 357', stroke: 30, gazeX: 0, gazeY: 2, top: 13, bottom: 0, leftAngle: 20, rightAngle: -20, folds: ['M 135 157 C 161 157 184 168 210 181', 'M 302 181 C 328 168 351 157 377 157'] },
          surprised: { mouth: 'M 251 351 C 253 351 259 351 261 351', stroke: 34, gazeX: 0, gazeY: -4, top: 0, bottom: 0, leftAngle: 0, rightAngle: 0 },
          attentive: { mouth: 'M 176 340 C 214 354 298 354 336 340', stroke: 27, gazeX: 6, gazeY: 0, top: 4, bottom: 2, leftAngle: -6, rightAngle: 6 },
          privacy: { mouth: 'M 190 351 C 224 351 288 351 322 351', stroke: 25, gazeX: 0, gazeY: 0, top: 0, bottom: 0, leftAngle: 0, rightAngle: 0, hideLids: true, eyes: ['M 130 210 C 147 224 175 224 192 210', 'M 320 210 C 337 224 365 224 382 210'], eyeStroke: 16 },
        };
        let currentEmotion = 'happy';
        let pointerX = 0;
        let pointerY = 0;
        let gazeX = 0;
        let gazeY = 0;
        let gazeFrame = 0;
        let faceRect = null;
        let idleTimer = 0;
        let emotionTimer = 0;
        let pokeTimer = 0;
        let pokeHeld = false;
        let blinkTimer = 0;
        let blinkFrame = 0;
        let expressionFrame = 0;

        const collapsedFolds = [
          'M 161 178 C 161 178 161 178 161 178',
          'M 351 178 C 351 178 351 178 351 178',
        ];
        const openEyes = [
          'M 161 208.5 C 161 208.7 161 208.8 161 209 C 161 209.2 161 209.3 161 209.5',
          'M 351 208.5 C 351 208.7 351 208.8 351 209 C 351 209.2 351 209.3 351 209.5',
        ];

        function pathNumbers(path) {
          return (path.match(/-?\d+(?:\.\d+)?/g) || []).map(Number);
        }

        function normalizeDoubleCubic(path) {
          const values = pathNumbers(path);
          if (values.length === 14) return values;
          const [x0, y0, x1, y1, x2, y2, x3, y3] = values;
          return [
            x0, y0,
            (x0 + x1) / 2, (y0 + y1) / 2,
            (x0 + 2 * x1 + x2) / 4, (y0 + 2 * y1 + y2) / 4,
            (x0 + 3 * x1 + 3 * x2 + x3) / 8, (y0 + 3 * y1 + 3 * y2 + y3) / 8,
            (x1 + 2 * x2 + x3) / 4, (y1 + 2 * y2 + y3) / 4,
            (x2 + x3) / 2, (y2 + y3) / 2,
            x3, y3,
          ];
        }

        function doubleCubicPath(values) {
          return `M ${values[0]} ${values[1]} C ${values[2]} ${values[3]} ${values[4]} ${values[5]} ${values[6]} ${values[7]} C ${values[8]} ${values[9]} ${values[10]} ${values[11]} ${values[12]} ${values[13]}`;
        }

        function expressionState(emotion) {
          const foldPaths = emotion.folds || collapsedFolds;
          const eyePaths = emotion.eyes || openEyes;
          return {
            mouth: normalizeDoubleCubic(emotion.mouth),
            stroke: emotion.stroke,
            leftEye: normalizeDoubleCubic(eyePaths[0]),
            rightEye: normalizeDoubleCubic(eyePaths[1]),
            eyeStroke: emotion.eyeStroke || 48,
            top: emotion.top,
            bottom: emotion.bottom,
            leftAngle: emotion.leftAngle,
            rightAngle: emotion.rightAngle,
            leftFold: normalizeDoubleCubic(foldPaths[0]),
            rightFold: normalizeDoubleCubic(foldPaths[1]),
            foldStroke: emotion.folds ? 20 : 0,
          };
        }

        function interpolate(from, to, progress) {
          return from + (to - from) * progress;
        }

        function interpolateList(from, to, progress) {
          return from.map((value, index) => interpolate(value, to[index], progress));
        }

        let renderedExpression = expressionState(emotions.happy);

        lids.lt.style.transformOrigin = lids.lb.style.transformOrigin = '161px 209px';
        lids.rt.style.transformOrigin = lids.rb.style.transformOrigin = '351px 209px';

        function measureFace() {
          faceRect = face.getBoundingClientRect();
        }

        function applyGaze(x, y) {
          const transform = `translate(${x}px, ${y}px)`;
          if (leftEyeAssembly) leftEyeAssembly.style.transform = transform;
          if (rightEyeAssembly) rightEyeAssembly.style.transform = transform;
        }

        function gazeTarget() {
          const emotion = emotions[currentEmotion] || emotions.happy;
          const followsPointer = currentEmotion !== 'privacy';
          return {
            x: emotion.gazeX + (followsPointer ? pointerX : 0),
            y: emotion.gazeY + (followsPointer ? pointerY : 0),
          };
        }

        function tickGaze() {
          const target = gazeTarget();
          gazeX += (target.x - gazeX) * 0.28;
          gazeY += (target.y - gazeY) * 0.28;
          if (Math.hypot(target.x - gazeX, target.y - gazeY) < 0.05) {
            gazeX = target.x;
            gazeY = target.y;
            gazeFrame = 0;
          } else {
            gazeFrame = requestAnimationFrame(tickGaze);
          }
          applyGaze(gazeX, gazeY);
        }

        function setGaze() {
          if (reducedMotion) {
            const target = gazeTarget();
            gazeX = target.x;
            gazeY = target.y;
            applyGaze(gazeX, gazeY);
            return;
          }
          if (!gazeFrame) gazeFrame = requestAnimationFrame(tickGaze);
        }

        function setLids(expression) {
          lids.lt.setAttribute('height', String(25 + expression.top));
          lids.rt.setAttribute('height', String(25 + expression.top));
          lids.lb.setAttribute('y', String(233 - expression.bottom));
          lids.rb.setAttribute('y', String(233 - expression.bottom));
          lids.lb.setAttribute('height', String(25 + expression.bottom));
          lids.rb.setAttribute('height', String(25 + expression.bottom));
          lids.lt.style.transform = lids.lb.style.transform = `rotate(${expression.leftAngle}deg)`;
          lids.rt.style.transform = lids.rb.style.transform = `rotate(${expression.rightAngle}deg)`;
        }

        function renderExpression(expression) {
          leftEye.setAttribute('d', doubleCubicPath(expression.leftEye));
          rightEye.setAttribute('d', doubleCubicPath(expression.rightEye));
          leftEye.setAttribute('stroke-width', String(expression.eyeStroke));
          rightEye.setAttribute('stroke-width', String(expression.eyeStroke));
          mouth.setAttribute('d', doubleCubicPath(expression.mouth));
          mouth.setAttribute('stroke-width', String(expression.stroke));
          leftFold.setAttribute('d', doubleCubicPath(expression.leftFold));
          rightFold.setAttribute('d', doubleCubicPath(expression.rightFold));
          folds.setAttribute('stroke-width', String(expression.foldStroke));
          setLids(expression);
        }

        function setEmotion(name) {
          const emotion = emotions[name];
          if (!emotion) return;
          if (pokeHeld && name !== 'angry') return;
          if (name !== 'angry') window.clearTimeout(pokeTimer);
          if (name === currentEmotion && face.dataset.emotion === name) return;
          currentEmotion = name;
          Object.values(lids).forEach((lid) => {
            lid.style.visibility = emotion.hideLids ? 'hidden' : 'visible';
          });
          setGaze();
          face.dataset.emotion = name;
          window.cancelAnimationFrame(blinkFrame);
          window.cancelAnimationFrame(expressionFrame);
          blinkFrame = 0;
          expressionFrame = 0;
          const from = {
            ...renderedExpression,
            mouth: [...renderedExpression.mouth],
            leftEye: [...renderedExpression.leftEye],
            rightEye: [...renderedExpression.rightEye],
            leftFold: [...renderedExpression.leftFold],
            rightFold: [...renderedExpression.rightFold],
          };
          const target = expressionState(emotion);
          const duration = reducedMotion ? 0 : 460;
          const startedAt = performance.now();

          function morph(now) {
            const linear = duration ? Math.min(1, (now - startedAt) / duration) : 1;
            const progress = 1 - Math.pow(1 - linear, 3);
            renderedExpression = {
              mouth: interpolateList(from.mouth, target.mouth, progress),
              stroke: interpolate(from.stroke, target.stroke, progress),
              leftEye: interpolateList(from.leftEye, target.leftEye, progress),
              rightEye: interpolateList(from.rightEye, target.rightEye, progress),
              eyeStroke: interpolate(from.eyeStroke, target.eyeStroke, progress),
              top: interpolate(from.top, target.top, progress),
              bottom: interpolate(from.bottom, target.bottom, progress),
              leftAngle: interpolate(from.leftAngle, target.leftAngle, progress),
              rightAngle: interpolate(from.rightAngle, target.rightAngle, progress),
              leftFold: interpolateList(from.leftFold, target.leftFold, progress),
              rightFold: interpolateList(from.rightFold, target.rightFold, progress),
              foldStroke: interpolate(from.foldStroke, target.foldStroke, progress),
            };
            renderExpression(renderedExpression);
            if (linear < 1) expressionFrame = requestAnimationFrame(morph);
            else expressionFrame = 0;
          }

          morph(startedAt);
        }

        function formEmotion() {
          if (!email.value && !password.value) return 'neutral';
          if (email.checkValidity() && password.checkValidity()) return 'happy';
          return 'attentive';
        }

        function restoreContext() {
          if (pokeHeld) return;
          const next = document.activeElement === password
            ? 'privacy'
            : document.activeElement === email
              ? 'attentive'
              : formEmotion();
          window.clearTimeout(emotionTimer);
          emotionTimer = window.setTimeout(() => setEmotion(next), 180);
        }

        function armIdle() {
          window.clearTimeout(idleTimer);
          if (authPanel?.hidden || pokeHeld) return;
          idleTimer = window.setTimeout(() => setEmotion(document.activeElement === password ? 'privacy' : 'neutral'), 10000);
        }

        function startPoke(event) {
          pokeHeld = true;
          window.clearTimeout(pokeTimer);
          window.clearTimeout(emotionTimer);
          window.clearTimeout(idleTimer);
          setEmotion('angry');
          const target = event?.currentTarget;
          if (event && 'pointerId' in event && target?.setPointerCapture) {
            try { target.setPointerCapture(event.pointerId); } catch {}
          }
        }

        function endPoke() {
          if (!pokeHeld) return;
          pokeHeld = false;
          window.clearTimeout(pokeTimer);
          pokeTimer = window.setTimeout(() => {
            const next = document.activeElement === password
              ? 'privacy'
              : document.activeElement === email
                ? 'attentive'
                : (email.value || password.value ? formEmotion() : 'happy');
            setEmotion(next);
            armIdle();
          }, 1000);
        }

        function trackPointer(event) {
          if (reducedMotion || authPanel?.hidden) return;
          if (!faceRect) measureFace();
          const nx = Math.max(-1, Math.min(1, (event.clientX - (faceRect.left + faceRect.width / 2)) / (faceRect.width * .75)));
          const ny = Math.max(-1, Math.min(1, (event.clientY - (faceRect.top + faceRect.height / 2)) / (faceRect.height * .75)));
          pointerX = nx * 13;
          pointerY = ny * 10;
          setGaze();
          armIdle();
        }

        function scheduleBlink() {
          if (reducedMotion) return;
          window.clearTimeout(blinkTimer);
          blinkTimer = window.setTimeout(() => {
            if (expressionFrame || currentEmotion === 'privacy') {
              scheduleBlink();
              return;
            }
            const base = { ...renderedExpression };
            const startedAt = performance.now();
            function renderBlink(now) {
              const progress = Math.min(1, (now - startedAt) / 210);
              const coverage = Math.sin(Math.PI * progress);
              setLids({
                ...base,
                top: interpolate(base.top, 34, coverage),
                bottom: interpolate(base.bottom, 14, coverage),
              });
              if (progress < 1) blinkFrame = requestAnimationFrame(renderBlink);
              else {
                blinkFrame = 0;
                scheduleBlink();
              }
            }
            blinkFrame = requestAnimationFrame(renderBlink);
          }, 3200 + Math.random() * 3600);
        }

        window.addEventListener('pointermove', trackPointer, { passive: true });
        window.addEventListener('resize', () => { faceRect = null; }, { passive: true });
        window.addEventListener('scroll', () => { faceRect = null; }, { passive: true });
        visualViewport?.addEventListener('resize', () => { faceRect = null; }, { passive: true });
        if (typeof ResizeObserver !== 'undefined') {
          new ResizeObserver(() => { faceRect = null; }).observe(faceWrap);
        }
        window.addEventListener('pointerout', (event) => {
          if (event.relatedTarget) return;
          pointerX = 0;
          pointerY = 0;
          setGaze();
        });
        window.addEventListener('keydown', armIdle, { passive: true });
        window.addEventListener('demo-face-emotion', (event) => setEmotion(event.detail));
        faceHit.addEventListener('pointerdown', (event) => {
          if (event.button) return;
          event.preventDefault();
          startPoke(event);
        });
        faceHit.addEventListener('pointerup', endPoke);
        faceHit.addEventListener('pointercancel', endPoke);
        window.addEventListener('pointerup', endPoke);
        window.addEventListener('pointercancel', endPoke);
        faceWrap.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          if (event.repeat) return;
          startPoke(event);
        });
        faceWrap.addEventListener('keyup', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          endPoke();
        });
        faceWrap.addEventListener('blur', () => {
          if (pokeHeld) endPoke();
        });
        [email, password].forEach((input) => {
          input.addEventListener('focus', () => {
            window.clearTimeout(emotionTimer);
            setEmotion(input === password ? 'privacy' : 'attentive');
            armIdle();
          });
          input.addEventListener('input', () => {
            window.clearTimeout(emotionTimer);
            setEmotion(input === password ? 'privacy' : 'attentive');
            armIdle();
          });
          input.addEventListener('blur', (event) => {
            const next = event.relatedTarget;
            if (next instanceof Node && (next === email || next === password || next.id === 'authPasswordToggle')) return;
            restoreContext();
            armIdle();
          });
          input.addEventListener('invalid', () => { setEmotion('worried'); armIdle(); });
        });
        form.addEventListener('submit', () => setEmotion('surprised'));

        setEmotion('happy');
        armIdle();
        scheduleBlink();
      })();
    </script>

    <div class="app-content" id="appContent" aria-hidden="true">
      <h1 id="screenTitle" class="sr-only">Llamada en tiempo real</h1>
      <div class="player-wrap">
        <section class="player" aria-label="Reproductor de llamada">
          <div class="monitor at-live-edge" id="waveShell" role="slider" tabindex="0" aria-label="Posición del audio" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0">
            <div class="wave-window" aria-hidden="true">
              <canvas class="wave-canvas" id="waveCanvas"></canvas>
            </div>
            <div class="progress-shell" aria-hidden="true">
              <div class="progress-fill"></div>
              <div class="playhead"></div>
            </div>
          </div>

          <div class="transport">
            <div class="timecode"><span id="currentTime">00:00</span> <span style="opacity:.34">/</span> <span id="duration">00:00</span></div>
                        <div class="controls" aria-label="Controles de llamada">
              <div class="control-stack">
                <button class="control" type="button" id="rewindBtn" aria-label="Reiniciar llamada" title="Reiniciar llamada"><i data-lucide="rotate-ccw" aria-hidden="true"></i></button>
                <span class="control-caption">Reiniciar</span>
              </div>
              <div class="control-stack">
                <button class="control primary" type="button" id="startBtn" aria-label="Empezar llamada" title="Empezar llamada"><i data-lucide="phone" aria-hidden="true"></i></button>
                <span class="control-caption">Llamar</span>
              </div>
              <div class="control-stack">
                <button class="control" type="button" id="playBtn" aria-label="Pausar llamada" title="Pausar llamada"><i data-lucide="pause" aria-hidden="true"></i></button>
                <span class="control-caption">Pausa</span>
              </div>
            </div>
          </div>
        </section>
      </div>

      <section class="conversation" id="conversation" aria-label="Transcripción de la llamada">
        <div class="conversation-empty" id="conversationEmpty" role="status">
          <div class="conversation-empty__copy"><i data-lucide="message-circle" aria-hidden="true"></i><p>Aún no hay mensajes.</p></div>
        </div>
      </section>
    </div>

    <section class="state-view" id="emptyState" hidden aria-label="Sin llamadas">
      <div class="state-copy"><i data-lucide="phone-off" aria-hidden="true"></i><p>No hay llamadas para monitorear.</p></div>
    </section>

    <section class="state-view" id="errorState" hidden aria-label="Error de monitoreo">
      <div class="state-copy"><i data-lucide="triangle-alert" aria-hidden="true"></i><p>No pudimos cargar el monitoreo de la llamada.</p></div>
    </section>

    <AnalyticsContent />
    <section class="section-view" data-section="call-1" aria-label="Llamada 1" aria-hidden="true">
