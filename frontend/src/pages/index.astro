    .tool-row.enter .tool-icon { animation: tool-icon-pop .82s .08s cubic-bezier(.18,.9,.25,1) both; }

    @keyframes tool-icon-pop {
      0% { transform: scale(.25) rotate(-18deg); opacity: 0; }
      68% { transform: scale(1.09) rotate(2deg); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }

    .tool-icon i, .tool-icon svg { width: 20px; height: 20px; stroke-width: 2.5; }
    .tool-copy, .loader, .done-mark { position: relative; z-index: 2; }
    .tool-copy { min-width: 0; flex: 1; }

    .tool-label {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 3px;
      font-size: 12px;
      font-weight: 700;
      opacity: .54;
    }

    .tool-label i, .tool-label svg { width: 13px; height: 13px; stroke-width: 2.5; }
    .tool-title { font-size: 15px; font-weight: 700; line-height: 1.3; }
    .tool-status { margin-top: 4px; font-size: 12px; font-weight: 600; opacity: .58; }

    .tool-status.loading {
      display: inline-flex;
      align-items: center;
      margin-top: 7px;
      padding: 5px 12px;
      min-height: 26px;
      border-radius: var(--radius-full);
      background: var(--ui-amber);
      color: var(--ui-graphite);
      opacity: 1;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .02em;
    }

    .tool-call:not(.done) .tool-icon {
      box-shadow: 0 0 0 4px rgba(247, 201, 116, .22);
    }

    .loader {
      position: absolute;
      right: 10px;
      top: 50%;
      margin-top: -29px;
      flex: 0 0 auto;
      width: 58px;
      height: 58px;
      filter: url(#ui-goo);
      -webkit-filter: url(#ui-goo);
      animation: ring-drift 15s linear infinite;
    }

    .loader-dot, .loader-runner, .loader-core {
      position: absolute;
      left: 50%;
      top: 50%;
      border-radius: 50%;
      background: var(--ui-amber);
    }

    .loader-dot {
      width: 10px;
      height: 10px;
      margin: -5px;
      transform-origin: center;
      opacity: .84;
    }

    .loader-core {
      width: 16px;
      height: 16px;
      margin: -8px;
      animation: loader-core-breathe 2.6s cubic-bezier(.55, .02, .45, .98) infinite;
    }

    .loader-runner {
      width: 14px;
      height: 14px;
      margin: -7px;
      transform-origin: center;
      animation: runner-orbit 7.8s cubic-bezier(.55,.02,.45,.98) infinite;
    }

    @keyframes ring-drift { to { transform: rotate(360deg); } }
    @keyframes runner-orbit {
      from { transform: rotate(0deg) translateY(-20px); }
      to { transform: rotate(360deg) translateY(-20px); }
    }
    @keyframes loader-core-breathe {
      0%, 100% { transform: scale(.78); }
      50% { transform: scale(1.12); }
    }

    .tool-call.done .loader { animation: loader-out .34s ease forwards; }
    @keyframes loader-out { to { opacity: 0; transform: scale(.35); } }

    .done-mark {
      position: absolute;
      right: 16px;
      top: 50%;
      margin-top: -19px;
      display: grid;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--ui-paper);
      color: var(--ui-graphite);
      place-items: center;
      opacity: 0;
      transform: scale(.3);
      pointer-events: none;
