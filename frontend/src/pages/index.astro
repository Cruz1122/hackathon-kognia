    <script is:inline>
      (() => {
        const panel = document.getElementById('authPanel');
        const form = document.querySelector('.login-form-content');
        const token = sessionStorage.getItem('kognia.auth.access-token')?.trim();
        const conversation = sessionStorage.getItem('kognia.auth.conversation-id')?.trim();
        if (!panel || !token || !conversation) return;
        panel.classList.add('is-app', 'no-wipe', 'is-nav-ready');
        panel.dataset.view = 'dashboard';
        panel.setAttribute('aria-labelledby', 'screenTitle');
        form?.setAttribute('inert', '');
        form?.setAttribute('aria-hidden', 'true');
        document.querySelector('.login-material')?.classList.add('is-gone');
      })();
    </script>
  </main>

  

  <script is:inline>
    const DEMO_DURATION = 3600;
    const SAMPLE_INTERVAL = 1 / 30;
    const VISUAL_SAMPLES = 128;

     window.__kogniaPageLeaving = false;
     let mode = 'live';
    let current = 0;
    let liveEdge = 0;
    let playing = true;
    let last = performance.now();
    let previousTimelineTime = 0;
    let seeking = false;
    let sampleAccumulator = 0;
    let externalAnalyser = null;
    let externalSampleRate = 16000;
    let analyserBins = null;
    let playbackAnalyser = null;
    let playbackSampleRate = 16000;
    let playbackBins = null;
    let callEnded = false;
    let waveDpr = 1;
    let waveWidth = 1;
    let waveHeight = 1;

    const liveSamples = [];
    const recordedSamples = [];

    const authPanel = document.getElementById('authPanel');
    const appContent = document.getElementById('appContent');
    const emptyState = document.getElementById('emptyState');
    const errorState = document.getElementById('errorState');
    const screenTitle = document.getElementById('screenTitle');
    const waveShell = document.getElementById('waveShell');
    const currentTimeEl = document.getElementById('currentTime');
    const durationEl = document.getElementById('duration');
    const playBtn = document.getElementById('playBtn');
    const startBtn = document.getElementById('startBtn');
    const liveBtn = document.getElementById('liveBtn');
    const conversationEmpty = document.getElementById('conversationEmpty');
    const waveCanvas = document.getElementById('waveCanvas');
    const waveCtx = waveCanvas.getContext('2d', { alpha: true });
    const reconnect = document.getElementById('reconnect');
    const reconnectText = document.getElementById('reconnectText');
    if (appContent) {
      let scrollRestTimer = 0;
      appContent.addEventListener('scroll', () => {
        appContent.classList.add('is-scrolling');
        window.clearTimeout(scrollRestTimer);
        scrollRestTimer = window.setTimeout(() => {
          appContent.classList.remove('is-scrolling');
        }, 780);
      }, { passive: true });
    }
    const timelineItems = [...document.querySelectorAll('.timeline-item')];
    const messages = [...document.querySelectorAll('.message[data-text]')];
    const tokenTimers = new Map();

    function formatTime(total) {
      const m = Math.floor(Math.max(0, total) / 60);
      const s = Math.floor(Math.max(0, total) % 60);
      return `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
    }

    function clamp01(v) { return Math.max(0, Math.min(1, v)); }

    function resample(values, count) {
      if (!values.length) return Array(count).fill(.04);
      if (values.length === 1) return Array(count).fill(values[0]);
      return Array.from({ length: count }, (_, i) => {
        const pos = i * (values.length - 1) / Math.max(1, count - 1);
        const lo = Math.floor(pos);
        const hi = Math.min(values.length - 1, lo + 1);
        const f = pos - lo;
        return values[lo] * (1 - f) + values[hi] * f;
      });
    }

    function resizeWaveCanvas() {
      const host = waveCanvas.parentElement || waveCanvas;
      const w = host.clientWidth;
      const h = host.clientHeight;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      if (w < 2 || h < 2) return false;
      const bitmapW = Math.max(1, Math.round(w * dpr));
      const bitmapH = Math.max(1, Math.round(h * dpr));
      const sizeChanged = w !== waveWidth || h !== waveHeight || dpr !== waveDpr;
      const bitmapChanged = waveCanvas.width !== bitmapW || waveCanvas.height !== bitmapH;
      if (!sizeChanged && !bitmapChanged) return false;
      waveWidth = w;
      waveHeight = h;
      waveDpr = dpr;
      if (bitmapChanged) {
        waveCanvas.width = bitmapW;
        waveCanvas.height = bitmapH;
      }
      waveCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
      return true;
    }

    function drawWaveShape(samples, from, to, fillStyle) {
      if (!samples.length || to <= from) return;
      const baseline = waveHeight - 1;
      const minHeight = Math.max(6, Math.round(waveHeight * 0.12));
      const travel = Math.max(8, Math.round(waveHeight * 0.48));
      const last = samples.length - 1;
      const startIndex = Math.max(0, Math.floor(from * last));
      const endIndex = Math.min(last, Math.ceil(to * last));
      const denom = Math.max(1, last);
      const amp = (sample) => minHeight + Math.pow(clamp01(sample), 1.55) * travel;

      waveCtx.beginPath();
      const firstX = startIndex / denom * waveWidth;
      waveCtx.moveTo(firstX, baseline);

      let prevX = firstX;
      let prevY = baseline - amp(samples[startIndex]);
      waveCtx.lineTo(prevX, prevY);

      for (let i = startIndex + 1; i <= endIndex; i++) {
        const x = i / denom * waveWidth;
        const y = baseline - amp(samples[i]);
        const mx = (prevX + x) * .5;
        const my = (prevY + y) * .5;
        waveCtx.quadraticCurveTo(prevX, prevY, mx, my);
        prevX = x;
        prevY = y;
      }
      waveCtx.lineTo(prevX, prevY);
      waveCtx.lineTo(prevX, baseline);
      waveCtx.closePath();
      waveCtx.fillStyle = fillStyle;
      waveCtx.fill();
    }

    function renderWave() {
      resizeWaveCanvas();
      waveCtx.clearRect(0, 0, waveWidth, waveHeight);

      const raw = mode === 'recorded' ? recordedSamples : liveSamples.slice(-VISUAL_SAMPLES);
      const samples = resample(raw, VISUAL_SAMPLES);
      if (!samples.length) return;

      const available = Math.max(.001, maxSeekTime());
      const ratio = clamp01(current / available);
      drawWaveShape(samples, 0, 1, 'rgba(65,65,65,.14)');
      drawWaveShape(samples, 0, ratio, '#f7c974');
    }

    // Pitch por autocorrelación (f0) + energía RMS. No usa bins FFT.
    function voiceLevelFromAnalyser(analyser, _frequencies, sampleRate) {
      const frame = new Float32Array(analyser.fftSize);
      analyser.getFloatTimeDomainData(frame);

      let energy = 0;
      for (let i = 0; i < frame.length; i++) energy += frame[i] * frame[i];
      const rms = Math.sqrt(energy / Math.max(1, frame.length));
      if (rms < .008) return clamp01(rms * 3);

      const minLag = Math.max(2, Math.floor(sampleRate / 500));
      const maxLag = Math.min(frame.length - 2, Math.floor(sampleRate / 70));
      let bestLag = minLag;
      let bestCorr = -1;
      const mean = energy / Math.max(1, frame.length);

      for (let lag = minLag; lag <= maxLag; lag++) {
        let corr = 0;
        const count = frame.length - lag;
        for (let i = 0; i < count; i++) corr += frame[i] * frame[i + lag];
        corr /= count;
        if (corr > bestCorr) {
          bestCorr = corr;
          bestLag = lag;
        }
      }

      const clarity = mean > 1e-8 ? bestCorr / mean : 0;
      const hz = sampleRate / bestLag;
      const voiced = clarity > .25 && hz >= 70 && hz <= 500;
      const pitch = voiced ? clamp01((hz - 70) / 430) : .35;
      return clamp01(rms * 4.2 * (.42 + .58 * (voiced ? .3 + .7 * pitch : .2)));
    }

    // Convierte un frame de frecuencias real en una amplitud visual de voz.
    // Los bins se ponderan principalmente entre 80 Hz y 3.8 kHz, rango útil para voz telefónica.
    function amplitudeFromFrequencyFrame(frequencies, sampleRate = 16000) {
      if (!frequencies || !frequencies.length) return .05;
      const nyquist = sampleRate / 2;
      let energy = 0;
      let weightSum = 0;

      for (let i = 0; i < frequencies.length; i++) {
        const hz = i / Math.max(1, frequencies.length - 1) * nyquist;
        if (hz < 80 || hz > 3800) continue;
        const speechWeight = hz < 300 ? .7 : hz < 2600 ? 1 : .72;
        const normalized = frequencies[i] / 255;
        energy += normalized * normalized * speechWeight;
        weightSum += speechWeight;
      }

      if (!weightSum) return .05;
      return clamp01(Math.sqrt(energy / weightSum) * 1.05);
    }

    function pushAmplitude(value) {
      if (callEnded || (mode === 'live' && liveEdge >= DEMO_DURATION)) return;
      liveSamples.push(clamp01(value));
      if (liveSamples.length > 1080) liveSamples.shift();
    }

    function pushFrequencyFrame(frequencies, sampleRate = 16000) {
      pushAmplitude(amplitudeFromFrequencyFrame(frequencies, sampleRate));
    }

    function readAnalyserFrame(analyser, bins, sampleRate) {
      try {
        analyser.getByteFrequencyData(bins);
        return { bins, sampleRate };
      } catch {
        try {
          return { amplitude: voiceLevelFromAnalyser(analyser, bins, sampleRate) };
        } catch {
          return null;
        }
      }
    }

    function mixFrequencyBins(left, leftRate, right, rightRate) {
      if (!left.length) return { bins: right, sampleRate: rightRate };
      if (!right.length) return { bins: left, sampleRate: leftRate };
      const length = Math.max(left.length, right.length);
      const mixed = new Uint8Array(length);
      for (let i = 0; i < length; i++) {
        const li = left[Math.min(left.length - 1, Math.floor(i * left.length / length))] ?? 0;
        const ri = right[Math.min(right.length - 1, Math.floor(i * right.length / length))] ?? 0;
        mixed[i] = li > ri ? li : ri;
      }
      return { bins: mixed, sampleRate: Math.max(leftRate, rightRate) };
    }

    const SPEECH_SEGMENTS = [
      [1.0, 4.7, 'customer'],
      [5.2, 8.9, 'agent'],
      [9.2, 11.9, 'customer'],
      [20.3, 25.3, 'agent'],
      [25.8, 27.5, 'customer'],
      [32.2, 35.5, 'agent']
    ];

    function speechEnvelope(t) {
      const segment = SPEECH_SEGMENTS.find(([start, end]) => t >= start && t <= end);
      if (!segment) return .025;
      const [start, end] = segment;
      const local = (t - start) / Math.max(.001, end - start);
      const attack = Math.min(1, local / .08);
      const release = Math.min(1, (1 - local) / .08);
      const syllables = .42 + .58 * Math.max(0, Math.sin(t * 8.4) * .55 + Math.sin(t * 4.15 + .7) * .35 + .28);
      return clamp01(syllables * Math.min(attack, release));
    }

    function demoFrequencyFrame(t) {
      const bins = new Uint8Array(128);
      const sampleRate = 16000;
      const nyquist = sampleRate / 2;
      const voice = speechEnvelope(t);
      const formants = [150, 620, 1180, 2250, 3150];
      const widths = [110, 260, 360, 520, 480];

      for (let i = 0; i < bins.length; i++) {
        const hz = i / (bins.length - 1) * nyquist;
        let mag = voice > .04 ? 4 : 1;
        formants.forEach((f, idx) => {
          const drift = Math.sin(t * (.8 + idx * .17) + idx) * (idx === 0 ? 35 : 90);
          const z = (hz - (f + drift)) / widths[idx];
          mag += Math.exp(-z * z) * voice * (idx === 0 ? 195 : 145 - idx * 13);
        });
        mag += voice * (Math.sin(i * .91 + t * 11) * .5 + .5) * 8;
        bins[i] = Math.max(0, Math.min(255, Math.round(mag)));
      }
      return bins;
    }

    // API preparada para conectar audio real sin cambiar el componente visual.
    window.callMonitorAudio = {
      pushAmplitude,
      pushFrequencyFrame,
      connectAnalyser(analyser, sampleRate = 16000) {
        externalAnalyser = analyser;
        externalSampleRate = sampleRate;
        analyserBins = new Uint8Array(analyser.frequencyBinCount);
        void analyser.context?.resume?.();
      },
      connectPlaybackAnalyser(analyser, sampleRate = 16000) {
        playbackAnalyser = analyser;
        playbackSampleRate = sampleRate;
        playbackBins = new Uint8Array(analyser.frequencyBinCount);
        void analyser.context?.resume?.();
      },
      disconnectPlaybackAnalyser() {
        playbackAnalyser = null;
        playbackBins = null;
      },
      disconnectAnalyser() {
        externalAnalyser = null;
        analyserBins = null;
        playbackAnalyser = null;
        playbackBins = null;
      },
      setPlaying,
      resetLiveWave() {
        liveSamples.length = 0;
        liveSamples.push(.025);
        liveEdge = 0;
        current = 0;
        sampleAccumulator = 0;
        callEnded = false;
        renderPlayer();
      },
      setRecordedWaveform(values) {
        recordedSamples.length = 0;
        values.forEach(v => recordedSamples.push(clamp01(v)));
        if (mode === 'recorded') renderWave();
      }
    };

    function seedRecordedWaveform() {
      recordedSamples.length = 0;
      for (let i = 0; i < 430; i++) {
        const t = i / 430 * DEMO_DURATION;
        recordedSamples.push(amplitudeFromFrequencyFrame(demoFrequencyFrame(t), 16000));
      }
    }

    function replacePlayIcon(name) { if (window.__liveDebugControls) return;
      const existing = playBtn.querySelector('svg, i');
      if (existing) existing.remove();
      const node = document.createElement('i');
      node.setAttribute('data-lucide', name);
      node.setAttribute('aria-hidden', 'true');
      playBtn.appendChild(node);
      lucide.createIcons({ attrs: { 'stroke-width': 2.5 } });
    }

    function setPlaying(next) {
      if (playing === next) return;
      playing = next;
      replacePlayIcon(playing ? 'pause' : 'play');
      playBtn.setAttribute('aria-label', playing ? 'Pausar' : 'Reproducir');
    }

    function clearTokenTimers(message) {
      const timers = tokenTimers.get(message) || [];
      timers.forEach(clearTimeout);
      tokenTimers.delete(message);
    }

    function renderMessageInstant(message) {
      clearTokenTimers(message);
      message.textContent = message.dataset.text;
      const stamp = document.createElement('span');
      stamp.className = 'message-time';
      stamp.textContent = message.dataset.time;
      stamp.style.opacity = '.48';
      stamp.style.transform = 'none';
      message.appendChild(stamp);
      message.classList.add('complete');
      message.dataset.rendered = '1';
    }

    function animateMessage(message) {
      clearTokenTimers(message);
      message.textContent = '';
      message.classList.remove('complete');
      message.dataset.rendered = '1';

      const parts = message.dataset.text.split(/(\s+)/).filter(Boolean);
      const tokenDelay = Math.min(92, Math.max(48, 1450 / parts.length));
      let visibleTokenIndex = 0;

      parts.forEach(part => {
        if (/^\s+$/.test(part)) { message.appendChild(document.createTextNode(part)); return; }
        const token = document.createElement('span');
        token.className = 'token';
        token.textContent = part;
        token.style.animationDelay = `${visibleTokenIndex * tokenDelay}ms`;
        message.appendChild(token);
        visibleTokenIndex++;
      });

      const stamp = document.createElement('span');
      stamp.className = 'message-time';
      stamp.textContent = message.dataset.time;
      message.appendChild(stamp);
      const timer = setTimeout(() => message.classList.add('complete'), visibleTokenIndex * tokenDelay + 260);
      tokenTimers.set(message, [timer]);
    }

    function resetMessage(message) {
      clearTokenTimers(message);
      message.textContent = '';
      message.classList.remove('complete');
      delete message.dataset.rendered;
    }

    function showItem(item, animate) {
      if (item.classList.contains('visible')) return;
      const followLive = appContent && appContent.scrollHeight - appContent.scrollTop - appContent.clientHeight <= 120;
      item.classList.add('visible');
      if (animate) {
        item.classList.remove('enter');
        void item.offsetWidth;
        item.classList.add('enter');
        setTimeout(() => item.classList.remove('enter'), 900);
      }
      const message = item.querySelector('.message[data-text]');
      if (message) animate ? animateMessage(message) : renderMessageInstant(message);
      if (animate && mode === 'live' && !seeking && followLive) setTimeout(() => item.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 180);
    }

    function hideItem(item) {
      if (!item.classList.contains('visible')) return;
      item.classList.remove('visible', 'enter');
      const message = item.querySelector('.message[data-text]');
      if (message) resetMessage(message);
    }

    function patchSession(partial) {
      window.dispatchEvent(new CustomEvent('call-session-patch', { detail: partial }));
    }

    function setNameResolved(resolved, animate) {
      patchSession({ name: resolved ? 'Sofía Martínez' : '' });
    }

    function setToolState(id, done, instant = false) {
      const tool = document.getElementById(id);
      if (!tool) return;
      const desired = done ? '1' : '0';
      if (!instant && tool.dataset.done === desired) return;
      tool.dataset.done = desired;

      const status = document.getElementById(id + 'Status');
      const title = document.getElementById(id + 'Title');
      tool.classList.toggle('done', done);
      if (status) status.classList.toggle('loading', !done);

      if (id === 'tool1') {
        title.textContent = done ? 'Reserva encontrada' : 'Consultando la reserva de Sofía Martínez';
        status.textContent = done ? 'Disponibilidad consultada · completado' : 'Buscando disponibilidad y condiciones';
      } else {
        title.textContent = done ? 'Reserva actualizada a las 5:30 p. m.' : 'Actualizando hora de llegada';
        status.textContent = done ? 'Cambio guardado · completado' : 'Guardando el cambio';
      }

      const loader = tool.querySelector('.loader');
      const mark = tool.querySelector('.done-mark');
      if (instant) {
        if (loader) loader.style.display = done ? 'none' : '';
        if (mark) { mark.style.opacity = done ? '1' : '0'; mark.style.transform = done ? 'scale(1)' : 'scale(.3)'; }
      } else {
        if (loader) loader.style.display = '';
        if (mark) { mark.style.opacity = ''; mark.style.transform = ''; }
        if (done) setTimeout(() => { if (tool.dataset.done === '1' && loader) loader.style.display = 'none'; }, 420);
      }
    }

    function syncTimeline(now, animateCrossings = true) {
      const movingForward = now >= previousTimelineTime;
      timelineItems.forEach(item => {
        const at = Number(item.dataset.at || 0);
        const shouldShow = now >= at;
        if (shouldShow) {
          const crossed = movingForward && previousTimelineTime < at && now >= at;
          showItem(item, animateCrossings && crossed);
        } else hideItem(item);
      });

      const crossedName = movingForward && previousTimelineTime < 11.2 && now >= 11.2;
      /* live: no resolver el nombre de la demo */

      const reconnected = now >= 14.9;
      reconnect?.classList.toggle('reconnected', reconnected);
      if (reconnectText) reconnectText.textContent = reconnected ? 'Reconectado · 2 s' : 'Reconectando';
      setToolState('tool1', now >= 19.2, !animateCrossings);
      setToolState('tool2', now >= 31.5, !animateCrossings);

      if (!window.__liveDebugControls) {
        const hasMessages = [...document.querySelectorAll('.message-row.timeline-item')].some(item => now >= Number(item.dataset.at || 0));
        conversationEmpty.hidden = hasMessages;
      }
      previousTimelineTime = now;
    }

    function maxSeekTime() { return mode === 'live' && !callEnded ? liveEdge : DEMO_DURATION; }

    function renderPlayer() {
      const available = Math.max(.001, maxSeekTime());
      const ratio = mode === 'live' && liveEdge < .001 ? 1 : clamp01(current / available);
      const atLiveEdge = mode === 'live' && Math.abs(current - liveEdge) < .14;

      waveShell.style.setProperty('--progress', `${ratio * 100}%`);
      currentTimeEl.textContent = formatTime(current);
      durationEl.textContent = formatTime(maxSeekTime());
      waveShell.setAttribute('aria-valuemax', Math.round(maxSeekTime()));
      waveShell.setAttribute('aria-valuenow', Math.round(current));
      waveShell.classList.toggle('at-live-edge', atLiveEdge);
      if (!window.__liveDebugControls) startBtn.disabled = current <= .01;
      if (liveBtn) liveBtn.disabled = mode !== 'live' || callEnded || atLiveEdge;
      if (liveBtn) liveBtn.hidden = mode !== 'live' || callEnded;
      renderWave();
    }

    function seek(value) {
      current = Math.max(0, Math.min(maxSeekTime(), value));
      const old = previousTimelineTime;
      previousTimelineTime = Math.min(old, current);
      syncTimeline(current, false);
      renderPlayer();
    }

    function jumpToLive() {
      if (mode !== 'live' || callEnded) return;
      const old = previousTimelineTime;
      current = liveEdge;
      previousTimelineTime = Math.min(old, current);
      syncTimeline(current, false);
      renderPlayer();
    }

    function seekFromPointer(clientX) {
      const rect = waveShell.getBoundingClientRect();
      const ratio = clamp01((clientX - rect.left) / rect.width);
      seek(ratio * maxSeekTime());
    }

    function beginSeek(e) {
      seeking = true;
      waveShell.classList.add('seeking');
      waveShell.setPointerCapture(e.pointerId);
      seekFromPointer(e.clientX);
    }

    let seekRevealTimer;
    function endSeek(e) {
      seeking = false;
      if (waveShell.hasPointerCapture(e.pointerId)) waveShell.releasePointerCapture(e.pointerId);
      clearTimeout(seekRevealTimer);
      seekRevealTimer = setTimeout(() => waveShell.classList.remove('seeking'), 420);
    }

    function resetConversation() {
      timelineItems.forEach(hideItem);
      messages.forEach(resetMessage);
      setToolState('tool1', false, true);
      setToolState('tool2', false, true);
      reconnect?.classList.remove('reconnected');
      if (reconnectText) reconnectText.textContent = 'Reconectando';
      conversationEmpty.hidden = false;
      previousTimelineTime = 0;
    }

    function setMode(next) {
      mode = next;
      document.querySelectorAll('.demo-switcher button').forEach(btn => btn.classList.toggle('active', btn.dataset.mode === mode));
      if (authPanel?.classList.contains('is-app')) {
        appContent.hidden = mode === 'empty' || mode === 'error';
      }
      emptyState.hidden = mode !== 'empty';
      errorState.hidden = mode !== 'error';

      if (mode === 'empty' || mode === 'error') {
        setPlaying(false);
        lucide.createIcons({ attrs: { 'stroke-width': 2.5 } });
        return;
      }

      resetConversation();
      current = 0;
      callEnded = false;
      setPlaying(true);

      if (mode === 'live') {
        liveEdge = 0;
        liveSamples.length = 0;
        sampleAccumulator = 0;
        if (screenTitle) screenTitle.textContent = 'Llamada en tiempo real';
        patchSession({ status: 'En vivo' });
        liveSamples.push(.025);
      } else {
        liveEdge = DEMO_DURATION;
        if (screenTitle) screenTitle.textContent = 'Grabación de llamada';
        patchSession({ status: 'Grabada' });
        renderWave();
      }

      renderPlayer();
      lucide.createIcons({ attrs: { 'stroke-width': 2.5 } });
    }

    function finalizeCall() {
      if (callEnded) return;
      callEnded = true;
      liveEdge = DEMO_DURATION;
      current = DEMO_DURATION;
      setPlaying(false);
      if (screenTitle) screenTitle.textContent = 'Llamada finalizada';
      patchSession({ status: 'Finalizada' });
      previousTimelineTime = Math.min(previousTimelineTime, DEMO_DURATION - .001);
      syncTimeline(DEMO_DURATION, true);
      renderPlayer();
      lucide.createIcons({ attrs: { 'stroke-width': 2.5 } });
    }

    if (!window.__liveDebugControls) playBtn.addEventListener('click', () => setPlaying(!playing));
    if (!window.__liveDebugControls) startBtn.addEventListener('click', () => seek(0));
    if (!window.__liveDebugControls) liveBtn?.addEventListener('click', jumpToLive);
    if (!window.__liveDebugControls) document.getElementById('rewindBtn').addEventListener('click', () => seek(current - 10));
    if (!window.__liveDebugControls) document.getElementById('forwardBtn')?.addEventListener('click', () => seek(current + 10));

    waveShell.addEventListener('pointerdown', beginSeek);
    waveShell.addEventListener('pointermove', e => { if (waveShell.hasPointerCapture(e.pointerId)) seekFromPointer(e.clientX); });
    waveShell.addEventListener('pointerup', endSeek);
    waveShell.addEventListener('pointercancel', endSeek);

    waveShell.addEventListener('keydown', e => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); seek(current - 5); }
      if (e.key === 'ArrowRight') { e.preventDefault(); seek(current + 5); }
      if (e.key === 'Home') { e.preventDefault(); seek(0); }
      if (e.key === 'End') { e.preventDefault(); seek(maxSeekTime()); }
      if (e.key === ' ') { e.preventDefault(); setPlaying(!playing); }
    });

    document.querySelectorAll('.demo-switcher button').forEach(btn => btn.addEventListener('click', () => setMode(btn.dataset.mode)));

    function tick(now) {
      const dt = Math.min(.05, (now - last) / 1000);
      last = now;

     if (window.__kogniaPageLeaving) return;

     if (mode === 'live' && !callEnded) {
        const wasAtEdge = Math.abs(current - liveEdge) < .14;
        const previousEdge = liveEdge;
        const frozen = window.__liveDebugControls && !playing;
        if (!frozen) liveEdge = Math.min(DEMO_DURATION, liveEdge + dt);
        if (frozen) sampleAccumulator = 0;
        else sampleAccumulator += dt;
        while (!frozen && sampleAccumulator >= SAMPLE_INTERVAL && liveEdge < DEMO_DURATION) {
          sampleAccumulator -= SAMPLE_INTERVAL;
          const sampleTime = Math.max(previousEdge, liveEdge - sampleAccumulator);
          const micFrame = externalAnalyser && analyserBins
            ? readAnalyserFrame(externalAnalyser, analyserBins, externalSampleRate)
            : null;
          const ttsFrame = playbackAnalyser && playbackBins
            ? readAnalyserFrame(playbackAnalyser, playbackBins, playbackSampleRate)
            : null;
          if (micFrame?.bins && ttsFrame?.bins) {
            const mixed = mixFrequencyBins(micFrame.bins, micFrame.sampleRate, ttsFrame.bins, ttsFrame.sampleRate);
            pushFrequencyFrame(mixed.bins, mixed.sampleRate);
          } else if (micFrame?.bins) {
            pushFrequencyFrame(micFrame.bins, micFrame.sampleRate);
          } else if (ttsFrame?.bins) {
            pushFrequencyFrame(ttsFrame.bins, ttsFrame.sampleRate);
          } else if (micFrame?.amplitude != null || ttsFrame?.amplitude != null) {
            pushAmplitude(Math.max(micFrame?.amplitude ?? 0, ttsFrame?.amplitude ?? 0));
          } else if (!window.__liveDebugControls) {
            pushFrequencyFrame(demoFrequencyFrame(sampleTime), 16000);
          }
        }

        if (playing && !seeking) {
          if (wasAtEdge) current = liveEdge;
          else current = Math.min(liveEdge, current + dt);
        }

        syncTimeline(current, true);
        renderPlayer();

        if (liveEdge >= DEMO_DURATION - .0001) finalizeCall();
      } else if (mode === 'recorded' && playing && !seeking) {
        const prev = current;
        current = Math.min(DEMO_DURATION, current + dt);
        previousTimelineTime = prev;
        syncTimeline(current, true);
        renderPlayer();
        if (current >= DEMO_DURATION) setPlaying(false);
      } else if (mode === 'live' && callEnded && playing && !seeking) {
        const prev = current;
        current = Math.min(DEMO_DURATION, current + dt);
        previousTimelineTime = prev;
        syncTimeline(current, true);
        renderPlayer();
        if (current >= DEMO_DURATION) setPlaying(false);
      } else if (mode === 'live' && callEnded) {
        renderPlayer();
      }

      requestAnimationFrame(tick);
    }

    if (waveShell) new ResizeObserver(() => renderWave()).observe(waveShell);
    const loginRight = document.querySelector('.login-right');
    if (loginRight) new ResizeObserver(() => renderWave()).observe(loginRight);
    window.addEventListener('resize', () => renderWave());
    visualViewport?.addEventListener('resize', () => renderWave());
    seedRecordedWaveform();
    lucide.createIcons({ attrs: { 'stroke-width': 2.5 } });
    setMode('live');
    if (window.__liveDebugControls) setPlaying(false);
    const trackWaveLayout = () => {
      let frames = 48;
      const step = () => {
        renderWave();
        frames -= 1;
        if (frames > 0) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    window.addEventListener('app-layout-change', trackWaveLayout);
    requestAnimationFrame(tick);
  </script>

       <script>
        import { bootDashboard } from '../features/dashboard/dashboard';
        import { backendErrorFromResponse, errorMessage } from '../features/voice-call/infrastructure/backend-error';

      const apiUrl = document.body.dataset.apiUrl ?? '';
      const authPanel = document.getElementById('authPanel');
      const authForm = document.getElementById('authForm');
       const authEmail = document.getElementById('authEmail');
        const authPassword = document.getElementById('authPassword');
        const authPasswordToggle = document.getElementById('authPasswordToggle');
        const authSubmit = document.getElementById('authSubmit');
       const appContent = document.getElementById('appContent');
       const loginFormContent = document.querySelector('.login-form-content');
       const tokenKey = 'kognia.auth.access-token';
       const conversationKey = 'kognia.auth.conversation-id';

       function setFaceEmotion(emotion: string): void {
         window.dispatchEvent(new CustomEvent('demo-face-emotion', { detail: emotion }));
       }

        function setLoginLoading(loading: boolean): void {
         if (!(authSubmit instanceof HTMLButtonElement)) return;
         authSubmit.disabled = loading;
         authSubmit.classList.toggle('is-loading', loading);
          authSubmit.setAttribute('aria-busy', String(loading));
          authSubmit.closest('.auth-submit-wrap')?.classList.toggle('is-loading', loading);
        }

        function setPasswordVisibility(visible: boolean): void {
          if (!(authPassword instanceof HTMLInputElement) || !(authPasswordToggle instanceof HTMLButtonElement)) return;
          authPassword.type = visible ? 'text' : 'password';
          authPasswordToggle.setAttribute('aria-label', visible ? 'Ocultar contraseña' : 'Mostrar contraseña');
          authPasswordToggle.setAttribute('aria-pressed', String(visible));
          authPasswordToggle.innerHTML = `<i data-lucide="${visible ? 'eye-off' : 'eye'}" aria-hidden="true"></i>`;
          const lucide = (window as Window & { lucide?: { createIcons: (opts?: object) => void } }).lucide;
          lucide?.createIcons({ attrs: { 'stroke-width': 2.5 } });
        }

        authPasswordToggle?.addEventListener('mousedown', (event) => {
          event.preventDefault();
        });
        authPasswordToggle?.addEventListener('click', () => {
          if (!(authPassword instanceof HTMLInputElement)) return;
          const visible = authPassword.type === 'password';
          setPasswordVisibility(visible);
        });
        setPasswordVisibility(false);

       function setFormInert(inert: boolean): void {
         if (!(loginFormContent instanceof HTMLElement)) return;
         if (inert) {
           loginFormContent.setAttribute('inert', '');
           loginFormContent.setAttribute('aria-hidden', 'true');
           return;
         }
         loginFormContent.removeAttribute('inert');
         loginFormContent.removeAttribute('aria-hidden');
       }

       function loginMaterial(): HTMLElement | null {
         const material = document.querySelector('.login-material');
         return material instanceof HTMLElement ? material : null;
       }

       function collapseStrip(immediate: boolean): void {
         const material = loginMaterial();
         if (!material) return;
         if (immediate) {
           material.classList.add('is-gone');
           return;
         }
         const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
         let fallback = 0;
         const onEnd = (event: TransitionEvent) => {
           if (event.propertyName !== 'width' && event.propertyName !== 'height') return;
           window.clearTimeout(fallback);
           material.removeEventListener('transitionend', onEnd);
           material.classList.add('is-gone');
         };
         fallback = window.setTimeout(() => {
           material.removeEventListener('transitionend', onEnd);
           material.classList.add('is-gone');
         }, reduced ? 40 : 2800);
         material.addEventListener('transitionend', onEnd);
       }

        function restoreStrip(): void {
          loginMaterial()?.classList.remove('is-gone');
        }

        let resizeStabilizationTimer = 0;
        function stabilizeLoginLayout(): void {
          const material = loginMaterial();
          authPanel?.classList.add('is-resizing');
          material?.classList.add('is-resizing');
          window.clearTimeout(resizeStabilizationTimer);
          resizeStabilizationTimer = window.setTimeout(() => {
            authPanel?.classList.remove('is-resizing');
            material?.classList.remove('is-resizing');
          }, 180);
        }

        window.addEventListener('resize', stabilizeLoginLayout, { passive: true });
        window.addEventListener('orientationchange', stabilizeLoginLayout, { passive: true });
        visualViewport?.addEventListener('resize', stabilizeLoginLayout, { passive: true });

         const appNav = document.getElementById('appNav');
        const mobileNavToggle = document.querySelector<HTMLButtonElement>('.mobile-nav-toggle');
        const callsGroup = document.getElementById('callsGroup');
       const callsToggle = document.getElementById('callsToggle');
       const sectionViews = Array.from(document.querySelectorAll<HTMLElement>('.section-view'));
       const detailPanel = document.getElementById('detailPanel');
        const railMs = 1550;
        const materialDelayMs = 1550;
        const materialCollapseMs = 850;
        const wipeMs = railMs + materialDelayMs + materialCollapseMs;
        let navReadyTimer = 0;
        let dashboardStarted = false;
        let dashboardCleanup: (() => void) | null = null;
        let analyticsHandoffPending = false;
       let navReadyHandler: ((event: TransitionEvent) => void) | null = null;

       function lucideRefresh(): void {
         const lucide = (window as Window & { lucide?: { createIcons: (opts?: object) => void } }).lucide;
         lucide?.createIcons({ attrs: { 'stroke-width': 2.5 } });
       }

       function clearNavReadyWait(): void {
         window.clearTimeout(navReadyTimer);
         if (navReadyHandler && authPanel) {
           authPanel.removeEventListener('transitionend', navReadyHandler);
         }
         navReadyHandler = null;
       }

        function markNavReady(): void {
         if (!authPanel) return;
          clearNavReadyWait();
          authPanel.classList.add('is-nav-ready');
          appNav?.removeAttribute('aria-hidden');
          syncMobileNavToggle();
          if (analyticsHandoffPending && authPanel.dataset.view === 'dashboard') {
            analyticsHandoffPending = false;
            history.replaceState(history.state, '', '/analytics');
            document.title = 'Kognia — Analíticas';
          }
       }

       function scheduleNavReady(immediate: boolean): void {
         if (!authPanel) return;
         if (immediate || matchMedia('(prefers-reduced-motion: reduce)').matches) {
           markNavReady();
           return;
         }
         clearNavReadyWait();
          const readyAt = performance.now() + wipeMs;
          navReadyHandler = (event: TransitionEvent) => {
            if (event.target !== authPanel) return;
            if (event.propertyName !== '--left-rail') return;
            if (performance.now() < readyAt - 16) return;
            markNavReady();
          };
          authPanel.addEventListener('transitionend', navReadyHandler);
          navReadyTimer = window.setTimeout(markNavReady, wipeMs);
       }

        function notifyLayoutChange(): void {
          window.dispatchEvent(new Event('app-layout-change'));
        }

        function syncMobileNavToggle(): void {
          if (!authPanel || !mobileNavToggle) return;
          mobileNavToggle.hidden = !authPanel.classList.contains('is-app') || !authPanel.classList.contains('is-nav-ready') || !isCompactShell();
          const collapsed = authPanel.classList.contains('is-rail-collapsed');
          mobileNavToggle.setAttribute('aria-expanded', String(!collapsed));
          mobileNavToggle.setAttribute('aria-label', collapsed ? 'Expandir navegación' : 'Contraer navegación');
          if (!isCompactShell() || !collapsed) appNav?.removeAttribute('inert');
          else appNav?.setAttribute('inert', '');
        }

        function setMobileNavExpanded(expanded: boolean): void {
          if (!authPanel?.classList.contains('is-app') || !isCompactShell()) return;
          authPanel.classList.toggle('is-rail-collapsed', !expanded);
          syncMobileNavToggle();
          notifyLayoutChange();
        }

       function setCallsOpen(open: boolean): void {
         callsGroup?.classList.toggle('is-open', open);
         callsToggle?.setAttribute('aria-expanded', String(open));
         const children = document.getElementById('callsChildren');
         if (open) {
           children?.removeAttribute('inert');
           children?.removeAttribute('aria-hidden');
           return;
         }
         children?.setAttribute('inert', '');
         children?.setAttribute('aria-hidden', 'true');
       }

       function setAppView(view: string): void {
         if (!authPanel) return;
         const empty = view !== 'call-demo';
         const isCall = view === 'call-demo' || view === 'call-1' || view === 'call-2';
         authPanel.dataset.view = view;
         authPanel.classList.toggle('is-empty-view', empty);
         if (!isCall) setCallsOpen(false);
         callsToggle?.classList.toggle('is-active', isCall);
         appNav?.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((button) => {
           const active = button.dataset.view === view;
           button.classList.toggle('is-active', active);
           if (active) button.setAttribute('aria-current', 'page');
           else button.removeAttribute('aria-current');
         });
         sectionViews.forEach((section) => {
           const active = empty && section.dataset.section === view;
           section.classList.toggle('is-active', active);
           section.setAttribute('aria-hidden', active ? 'false' : 'true');
           if (active) section.removeAttribute('inert');
           else section.setAttribute('inert', '');
         });
         notifyLayoutChange();
         if (empty) {
           appContent?.setAttribute('aria-hidden', 'true');
           appContent?.setAttribute('inert', '');
           detailPanel?.setAttribute('inert', '');
           return;
         }
         appContent?.removeAttribute('aria-hidden');
         appContent?.removeAttribute('inert');
         detailPanel?.removeAttribute('inert');
       }

        function resetAppShell(): void {
          clearNavReadyWait();
          authPanel?.classList.remove('is-app', 'no-wipe', 'is-nav-ready', 'is-empty-view', 'is-rail-collapsed');
          mobileNavToggle?.setAttribute('hidden', '');
          mobileNavToggle?.setAttribute('aria-expanded', 'false');
          mobileNavToggle?.setAttribute('aria-label', 'Expandir navegación');
         authPanel?.removeAttribute('data-view');
         appNav?.setAttribute('aria-hidden', 'true');
         appNav?.setAttribute('inert', '');
         setCallsOpen(false);
         callsToggle?.classList.remove('is-active');
          sectionViews.forEach((section) => {
            section.classList.remove('is-active');
            section.setAttribute('aria-hidden', 'true');
            section.setAttribute('inert', '');
          });
         appContent?.removeAttribute('inert');
         detailPanel?.removeAttribute('inert');
       }

        function revealApp(animate: boolean): void {
         if (!authPanel) return;
          if (!animate) authPanel.classList.add('no-wipe');
          authPanel.classList.add('is-app');
          authPanel.classList.toggle('is-rail-collapsed', isCompactShell());
          authPanel.setAttribute('aria-labelledby', 'screenTitle');
         setFormInert(true);
         setAppView('dashboard');
         collapseStrip(!animate);
         scheduleNavReady(!animate);
         lucideRefresh();
         notifyLayoutChange();
         if (!animate) {
           requestAnimationFrame(() => {
             requestAnimationFrame(() => authPanel.classList.remove('no-wipe'));
           });
         }
       }

       appNav?.addEventListener('click', (event) => {
         const target = event.target;
         if (!(target instanceof Element)) return;
         const toggle = target.closest('#callsToggle');
         if (toggle) {
           setCallsOpen(!callsGroup?.classList.contains('is-open'));
           return;
         }
         const button = target.closest<HTMLButtonElement>('[data-view]');
         if (!button) return;
         const view = button.dataset.view?.trim();
         if (!view) return;
         setAppView(view);
       });

        function isCompactShell(): boolean {
          return matchMedia('(max-width: 1100px)').matches;
        }
        mobileNavToggle?.addEventListener('click', () => {
          setMobileNavExpanded(authPanel?.classList.contains('is-rail-collapsed') ?? false);
        });
        matchMedia('(max-width: 1100px)').addEventListener('change', (event) => {
          if (!authPanel?.classList.contains('is-app')) return;
          authPanel.classList.toggle('is-rail-collapsed', event.matches);
          syncMobileNavToggle();
          notifyLayoutChange();
        });

        function preloadAnalytics(): void {
          void fetch('/analytics', { cache: 'force-cache', credentials: 'same-origin' }).catch(() => undefined);
        }

       function showApp(token: string, conversationId: string, animate = true): void {
         analyticsHandoffPending = true;
         preloadAnalytics();
         setFaceEmotion('happy');
         revealApp(animate);
         if (!dashboardStarted) {
           dashboardStarted = true;
           dashboardCleanup = bootDashboard(apiUrl, token);
         }
       }

       async function responseData(response: Response, fallback: string): Promise<Record<string, unknown>> {
         if (!response.ok) throw await backendErrorFromResponse(response, fallback);
         try {
          const data: unknown = await response.json();
          return data && typeof data === 'object' && !Array.isArray(data)
            ? data as Record<string, unknown>
            : {};
        } catch {
          return {};
        }
      }

      async function restoreSession(): Promise<void> {
        const token = sessionStorage.getItem(tokenKey)?.trim() ?? '';
        const conversationId = sessionStorage.getItem(conversationKey)?.trim() ?? '';
        if (!token || !conversationId) return;
        setFaceEmotion('surprised');
        const [me, conversation] = await Promise.all([
          fetch(`${apiUrl}/auth/me`, { headers: { Authorization: `Bearer ${token}` } }),
          fetch(`${apiUrl}/conversations/${encodeURIComponent(conversationId)}`, { headers: { Authorization: `Bearer ${token}` } }),
        ]);
        if (me.ok && conversation.ok) {
          showApp(token, conversationId, false);
          return;
        }
        const failedResponse = me.ok ? conversation : me;
        const sessionError = await backendErrorFromResponse(failedResponse, 'La sesión ya no está disponible.');
        sessionStorage.removeItem(tokenKey);
        sessionStorage.removeItem(conversationKey);
        resetAppShell();
        authPanel?.setAttribute('aria-labelledby', 'authTitle');
        setFormInert(false);
        appContent?.setAttribute('aria-hidden', 'true');
        restoreStrip();
        setFaceEmotion('neutral');
      }

      async function createSession(email: string, password: string): Promise<void> {
        const loginResponse = await fetch(`${apiUrl}/auth/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });
         const login = await responseData(loginResponse, 'No se pudo iniciar sesión.');
        const token = typeof login.access_token === 'string' ? login.access_token.trim() : '';
        if (!token) throw new Error('La API no devolvió una sesión válida.');

        const conversationResponse = await fetch(`${apiUrl}/conversations`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify({ channel: 'voice-demo' }),
        });
         const conversation = await responseData(conversationResponse, 'El usuario no puede abrir una conversación.');
        const conversationId = typeof conversation.id === 'string' ? conversation.id.trim() : '';
        if (!conversationId) throw new Error('La API no devolvió una conversación válida.');

        sessionStorage.setItem(tokenKey, token);
        sessionStorage.setItem(conversationKey, conversationId);
        showApp(token, conversationId);
      }

       authForm?.addEventListener('submit', (event) => {
         event.preventDefault();
        const email = authEmail instanceof HTMLInputElement ? authEmail.value : '';
        const password = authPassword instanceof HTMLInputElement ? authPassword.value : '';
         if (!(authSubmit instanceof HTMLButtonElement)) return;
          setLoginLoading(true);
         setFaceEmotion('surprised');
         void createSession(email, password)
           .catch((error: unknown) => {
              const message = errorMessage(error, 'No se pudo iniciar sesión.');
              setFaceEmotion(message.includes('inválidos') ? 'angry' : 'sad');
           })
           .finally(() => {
             setLoginLoading(false);
          });
      });

       document.addEventListener('astro:before-swap', () => {
         window.__kogniaPageLeaving = true;
         dashboardCleanup?.();
         dashboardCleanup = null;
       });

       void restoreSession().catch(() => {
        sessionStorage.removeItem(tokenKey);
        sessionStorage.removeItem(conversationKey);
        resetAppShell();
        authPanel?.setAttribute('aria-labelledby', 'authTitle');
        setFormInert(false);
        appContent?.setAttribute('aria-hidden', 'true');
        restoreStrip();
      });
    </script>
  </body>
</html>
