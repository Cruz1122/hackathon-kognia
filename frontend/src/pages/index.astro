      background: rgba(65,65,65,.09);
      color: var(--ui-graphite);
      transition: transform .2s cubic-bezier(.2,.8,.2,1), background .2s ease;
    }

    .control.primary {
      width: 48px;
      height: 48px;
      background: var(--ui-graphite);
      color: var(--ui-paper);
    }

    .control:hover:not(:disabled) { transform: translateY(-1px) scale(1.025); }
    .control:active:not(:disabled) { transform: translateY(1px) scale(.94,.97); }
    .control:focus-visible { outline: 3px solid var(--ui-amber); outline-offset: 3px; }
    .control:disabled { opacity: .28; cursor: default; }
    .control.live-jump:not(:disabled) { background: var(--ui-amber); }
    .control i, .control svg { width: 19px; height: 19px; stroke-width: 2.5; }
    .control.primary i, .control.primary svg { width: 22px; height: 22px; }

    .conversation {
      position: relative;
      width: 100%;
      margin: 26px auto 0;
      padding: 8px 10px 32px;
