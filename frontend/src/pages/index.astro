              <span>Usuario</span>
              <input id="authEmail" name="email" type="email" autocomplete="username" required maxlength="320" />
            </label>
            <label class="auth-field auth-password-field">
              <span>Contraseña</span>
              <input id="authPassword" name="password" type="password" autocomplete="current-password" required maxlength="128" />
              <button class="auth-password-toggle" type="button" id="authPasswordToggle" aria-label="Mostrar contraseña" aria-pressed="false">
                <i data-lucide="eye" aria-hidden="true"></i>
