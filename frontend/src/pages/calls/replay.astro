---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Kognia — Replay">
  <section class="replay-page">
    <header>
      <p class="replay-kicker">Historial</p>
      <h1>Replay de la llamada</h1>
    </header>
    <canvas width="960" height="120" aria-label="Forma de onda"></canvas>
    <audio controls></audio>
    <div class="replay-meta">
      <span data-lifecycle>STARTING</span>
      <span data-agent>listening</span>
    </div>
    <h2>Transcript</h2>
    <div data-transcript></div>
    <h2>Tools</h2>
    <p data-tools>Sin tools</p>
    <h2>RAG</h2>
    <p data-rag>Sin RAG</p>
  </section>
</AppLayout>

<style>
  .replay-page {
    width: min(960px, calc(100% - 32px));
    margin: 0 auto;
    padding: 32px 0 84px;
    color: #414141;
    font-family: "Urbanist", sans-serif;
  }
  .replay-kicker { margin: 0 0 6px; font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  h1 { margin: 0 0 18px; font-size: clamp(28px, 4vw, 42px); }
  canvas, audio { width: 100%; background: #faeccf; border-radius: min(32px, 50%); }
  canvas { height: 120px; cursor: pointer; }
  .replay-meta { display: flex; gap: 8px; margin: 14px 0; }
  .replay-meta span {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    padding: 0 14px;
    border-radius: 999px;
    background: #f7c974;
  }
</style>

<script>
  import { bootReplay } from '../../features/calls/replay';
  import { accessTokenKey, checkSession, redirectToLogin } from '../../features/auth/session-guard';

  const apiUrl = document.body.dataset.apiUrl ?? '';
  let cleanup: (() => void) | null = null;

  async function mount(): Promise<void> {
    const root = document.querySelector<HTMLElement>('.replay-page');
    if (!root) return;
    if ((await checkSession(apiUrl)) === 'invalid' || !sessionStorage.getItem(accessTokenKey)) {
      redirectToLogin();
      return;
    }
    cleanup?.();
    cleanup = bootReplay(root, apiUrl);
  }

  void mount();
  document.addEventListener('astro:page-load', () => { void mount(); });
</script>
