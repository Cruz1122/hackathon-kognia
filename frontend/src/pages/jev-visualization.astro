---
import AgentSignalsPanel from '../components/agent-signals/AgentSignalsPanel.astro';
import { DEMO_FRAMES } from '../lib/agent-signals/demo';
import '../styles/detail-panel.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>JEV · Agent Signals</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Urbanist:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="validation-shell">
      <main class="validation-page">
        <header class="validation-header">
          <div>
            <p class="validation-kicker">Vista temporal</p>
            <h1>Señales del agente</h1>
          </div>
          <p>La demo recorre estados numéricos y categóricos. Los controles permiten fijar anclas y miradas para inspección.</p>
        </header>

        <section class="validation-controls" aria-label="Controles de validación">
          <div class="validation-controls__group">
            <strong>Satisfacción</strong>
            <button type="button" data-anchor="very_low">0 · angry</button>
            <button type="button" data-anchor="low">1.25 · sad</button>
            <button type="button" data-anchor="neutral">2.5 · surprised</button>
            <button type="button" data-anchor="high">3.75 · intimidated</button>
            <button type="button" data-anchor="very_high">5 · happy</button>
          </div>
          <div class="validation-controls__group">
            <strong>Mirada</strong>
            <button type="button" data-gaze="left">Izquierda</button>
            <button type="button" data-gaze="right">Derecha</button>
            <button type="button" data-gaze="up">Arriba</button>
            <button type="button" data-gaze="down">Abajo</button>
            <button type="button" data-demo-restart>Reanudar demo</button>
          </div>
        </section>

        <AgentSignalsPanel id="jev-agent-signals" class="validation-signals" initialData={DEMO_FRAMES[0]} autoDemo={true} demoIntervalMs={2200} />
      </main>

      <aside class="detail-panel validation-detail-panel" aria-label="Señales compactas del agente">
        <div class="detail-panel__session">
          <p class="detail-kicker">Agente</p>
          <h2 class="detail-title">Señales en tiempo real</h2>
          <AgentSignalsPanel
            id="jev-agent-signals-compact"
            class="validation-signals"
            variant="compact"
            initialData={DEMO_FRAMES[0]}
            autoDemo={true}
            demoIntervalMs={2200}
          />
        </div>
      </aside>
    </div>

    <script>
      import type { AgentSignalsEnvelope, OrdinalValue } from '../lib/agent-signals/types';

      interface PanelElement extends HTMLElement {
        setSignals?: (data: AgentSignalsEnvelope) => void;
        startDemo?: () => void;
        stopDemo?: () => void;
        startGaze?: () => void;
        stopGaze?: () => void;
      }

      interface MascotElement extends HTMLElement {
        lookAt?: (clientX: number, clientY: number) => void;
      }

      const anchors: Record<OrdinalValue, AgentSignalsEnvelope['signals']['satisfaction']['probabilities']> = {
        very_low: { very_low: 1 },
        low: { low: 1 },
        neutral: { neutral: 1 },
        high: { high: 1 },
        very_high: { very_high: 1 },
      };

      function installValidationControls(): void {
        const panels = [...document.querySelectorAll<PanelElement>('.validation-signals')];
        const primaryPanel = panels[0];
        if (!primaryPanel || primaryPanel.dataset.controlsReady === 'true') return;
        primaryPanel.dataset.controlsReady = 'true';
        const initial = JSON.parse(primaryPanel.dataset.initial ?? '{}') as AgentSignalsEnvelope;

        document.querySelectorAll<HTMLButtonElement>('[data-anchor]').forEach((button) => {
          button.addEventListener('click', () => {
            const value = button.dataset.anchor as OrdinalValue;
            panels.forEach((panel) => {
              panel.stopDemo?.();
              panel.setSignals?.({
                signals: {
                  ...initial.signals,
                  satisfaction: { value, probabilities: anchors[value] },
                },
              });
            });
          });
        });

        document.querySelectorAll<HTMLButtonElement>('[data-gaze]').forEach((button) => {
          button.addEventListener('click', () => {
            const targets: Record<'left' | 'right' | 'up' | 'down', readonly [number, number]> = {
              left: [24, innerHeight / 2],
              right: [innerWidth - 24, innerHeight / 2],
              up: [innerWidth / 2, 24],
              down: [innerWidth / 2, innerHeight - 24],
            };
            const target = targets[button.dataset.gaze as keyof typeof targets];
            panels.forEach((panel) => {
              panel.stopGaze?.();
              panel.querySelectorAll<MascotElement>('[data-mascot-face]').forEach((mascot) => mascot.lookAt?.(...target));
            });
          });
        });

        document.querySelector<HTMLButtonElement>('[data-demo-restart]')?.addEventListener('click', () => {
          panels.forEach((panel) => {
            panel.startGaze?.();
            panel.startDemo?.();
          });
        });
      }

      installValidationControls();
      document.addEventListener('astro:page-load', installValidationControls);
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ui-graphite: #414141;
    --ui-amber: #f7c974;
    --ui-cream: #faeccf;
    --ui-paper: #f8f8f8;
    --radius-full: 9999px;
    --radius-max: 32px;
    --radius-ui: min(var(--radius-max), 50%);
    --font-ui: "Urbanist", sans-serif;
  }

  * { box-sizing: border-box; }

  html,
  body {
    height: 100%;
    min-height: 100%;
    margin: 0;
    overflow: hidden;
  }

  body {
    background: var(--ui-cream);
    color: var(--ui-graphite);
    font-family: var(--font-ui);
  }

  button { font: inherit; }

  .validation-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(290px, min(22vw, 336px));
    height: 100dvh;
    min-height: 100dvh;
    overflow: hidden;
  }

  .validation-page {
    min-width: 0;
    min-height: 0;
    padding: 28px;
    overflow-x: hidden;
    overflow-y: auto;
  }

  .validation-detail-panel {
    position: sticky;
    top: 0;
    align-self: start;
    z-index: 2;
  }

  .validation-header {
    margin-bottom: 18px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
  }

  .validation-kicker { margin: 0 0 4px; font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; }
  .validation-header h1 { margin: 0; font-size: clamp(2rem, 4vw, 3.6rem); line-height: .92; font-weight: 800; }
  .validation-header > p { max-width: 560px; margin: 0; font-weight: 500; }

  .validation-controls {
    margin-bottom: 18px;
    padding: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    border-radius: var(--radius-ui);
    background: var(--ui-paper);
  }

  .validation-controls__group { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .validation-controls__group strong { margin-right: 4px; }

  .validation-controls button {
    min-height: 34px;
    padding: 7px 12px;
    border: 0;
    border-radius: var(--radius-full);
    background: var(--ui-amber);
    color: var(--ui-graphite);
    font-weight: 700;
    cursor: pointer;
    transition: transform 160ms ease;
  }

  .validation-controls button:hover { transform: scale(1.02, .98); }
  .validation-controls button:active { transform: scale(.97, .94); }
  .validation-controls button:focus-visible { outline: 3px solid var(--ui-graphite); outline-offset: 2px; }

  @media (max-width: 1100px) {
    html,
    body { height: auto; overflow: auto; }
    .validation-shell { grid-template-columns: 1fr; height: auto; overflow: visible; }
    .validation-page { overflow: visible; }
    .validation-detail-panel { position: static; }
  }

  @media (max-width: 760px) {
    .validation-page { padding: 18px; }
    .validation-header { align-items: start; flex-direction: column; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: .001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: .001ms !important;
    }
  }
</style>
