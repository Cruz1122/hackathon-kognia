---
import MascotFace from './MascotFace.astro';

interface Props {
  class?: string;
  label?: string;
  mascotClass?: string;
  passwordInputId?: string;
}

const {
  class: className,
  label = 'Cambiar expresión de la mascota',
  mascotClass,
  passwordInputId,
} = Astro.props;
const id = `interactive-mascot-${crypto.randomUUID()}`;
---

<button class:list={['interactive-mascot', className]} type="button" aria-label={label} data-mascot-trigger data-mascot-id={id} data-password-input-id={passwordInputId}>
  <MascotFace id={id} class={mascotClass} emotion="default-happy" ariaLabel="Mascota de Demo" />
</button>

<script>
  interface MascotElement extends HTMLElement {
    setEmotion?: (emotion: string) => void;
  }

  function initializeMascotTriggers(): void {
    document.querySelectorAll<HTMLButtonElement>('[data-mascot-trigger]:not([data-trigger-ready])').forEach((trigger) => {
      trigger.dataset.triggerReady = 'true';
      let resetTimer = 0;
      const mascot = document.getElementById(trigger.dataset.mascotId ?? '') as MascotElement | null;
      const passwordInput = trigger.dataset.passwordInputId
        ? document.getElementById(trigger.dataset.passwordInputId) as HTMLInputElement | null
        : null;

      const restoreContext = (): void => {
        const passwordToggle = document.getElementById('authPasswordToggle');
        const isPasswordContext = document.activeElement === passwordInput || document.activeElement === passwordToggle;
        mascot?.setEmotion?.(isPasswordContext ? 'privacy' : 'default-happy');
      };

      trigger.addEventListener('click', () => {
        mascot?.setEmotion?.('intimidated');
        window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          resetTimer = 0;
          restoreContext();
        }, 1000);
      });

      const showPrivacy = (): void => {
        window.clearTimeout(resetTimer);
        resetTimer = 0;
        mascot?.setEmotion?.('privacy');
      };

      passwordInput?.addEventListener('focus', showPrivacy);
      passwordInput?.addEventListener('input', showPrivacy);
      passwordInput?.addEventListener('blur', () => window.setTimeout(() => {
        if (!resetTimer) restoreContext();
      }));
    });
  }

  initializeMascotTriggers();
  document.addEventListener('astro:page-load', initializeMascotTriggers);
</script>

<style>
  .interactive-mascot {
    display: grid;
    width: var(--interactive-mascot-width, 100%);
    aspect-ratio: 1;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .interactive-mascot:focus-visible {
    outline: 3px solid var(--ui-accent);
    outline-offset: 4px;
  }

  .interactive-mascot:active {
    transform: scale(.96, .98);
  }

  @media (prefers-reduced-motion: reduce) {
    .interactive-mascot { transition-duration: .001ms !important; }
  }
</style>
